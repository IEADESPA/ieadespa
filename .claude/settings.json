{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "claude-security@anthropic-plugin-directory": true,
    "pr-review-toolkit@anthropic-plugin-directory": true,
    "typescript-lsp@anthropic-plugin-directory": true,
    "microsoft-docs@anthropic-plugin-directory": true,
    "claude-md-management@anthropic-plugin-directory": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/continuidade/aviso-inicio.mjs\"",
            "timeout": 30,
            "statusMessage": "Conferindo a bancada (Em uso por, git pull e o kit)..."
          }
        ]
      }
    ]
  }
}
