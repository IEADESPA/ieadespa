# Arquivos de segredo criptografados por SOPS (metadados no formato dotenv)
# quebram o parser do SOPS se ganharem CRLF no checkout — força LF sempre,
# independente do core.autocrlf de cada máquina Windows.
*.enc.json text eol=lf
secrets.env text eol=lf
.sops.yaml text eol=lf

# Bibliotecas de terceiros copiadas para dentro (SheetJS, qrcode-generator, jsQR): ficam byte a byte como o autor publicou,
# sem conversão de quebra de linha em nenhuma máquina.
app/vendor/* -text
site/public/vendor/* -text
