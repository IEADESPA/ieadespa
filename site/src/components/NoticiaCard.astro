---
import { categoryLabel, formatDate, noticiaHref, readingLabel, type Noticia } from "@/lib/noticias";

interface Props {
  noticia: Noticia;
  variant?: "lead" | "feed" | "compact";
  headingLevel?: "h2" | "h3";
}

const { noticia, variant = "feed", headingLevel = "h2" } = Astro.props;
const { title, excerpt, date, category, cover } = noticia.data;
const href = noticiaHref(noticia);
const Heading = headingLevel;
const isoDate = date.toISOString();
const readableDate = formatDate(date);
---

<article class:list={["noticia-card", `noticia-card-${variant}`]}>
  <a href={href} class="link-title">
    {
      cover && (
        <div class="noticia-cover">
          <img src={cover} alt="" loading={variant === "lead" ? "eager" : "lazy"} />
        </div>
      )
    }

    <p class="meta card-toprow">
      <span class="pill">{categoryLabel(category)}</span>
      <time class="meta-accent" datetime={isoDate}>{readableDate}</time>
    </p>

    <Heading class="card-title link-title__text">{title}</Heading>
    <p class="card-excerpt">{excerpt}</p>

    {variant !== "compact" && <p class="meta card-footer">{readingLabel(noticia)}</p>}
  </a>
</article>

<style>
  .noticia-cover {
    overflow: hidden;
    margin-bottom: 1rem;
    border-radius: var(--radius-md);
    aspect-ratio: 16 / 9;
  }

  .noticia-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-toprow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.75rem;
  }

  .card-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .card-excerpt {
    margin: 0.6rem 0 0;
    color: color-mix(in srgb, var(--foreground) 88%, transparent);
    font-size: 1rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  .card-footer {
    margin: 0.9rem 0 0;
  }

  .noticia-card-lead .card-title {
    font-size: var(--text-title-lg);
    line-height: 1.08;
  }

  .noticia-card-lead .card-excerpt {
    max-width: 46rem;
    font-size: var(--text-body-lg);
  }

  .noticia-card-compact .noticia-cover {
    aspect-ratio: 16 / 10;
  }

  .noticia-card-compact .card-title {
    font-size: 1.1875rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .noticia-card-compact .card-excerpt {
    margin-top: 0.4rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.6;
  }
</style>
