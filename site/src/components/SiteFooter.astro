---
import LocalIcon from "@/components/LocalIcon.astro";
import { footerNavigation, siteConfig } from "@/config/site";

const socialIconByLabel = {
  Instagram: "instagram",
  Facebook: "facebook",
  YouTube: "youtube",
  RSS: "rss",
} as const;

const socials = siteConfig.socials.map((item) => ({
  ...item,
  icon: socialIconByLabel[item.label as keyof typeof socialIconByLabel] ?? "link-45deg",
}));
const currentYear = new Date().getFullYear();
---

<footer class="outer mt-[var(--space-section)] border-t border-border">
  <div class="inner py-12">
    <div class="footer-top grid gap-10 text-center sm:grid-cols-2 sm:text-left lg:grid-cols-[1.2fr_repeat(3,1fr)]">
      <div>
        <a href="/" class="wordmark"><img src="/logo-icon.png" alt={siteConfig.name} width="40" height="40" /></a>
        <p class="mt-3 max-w-[22rem] text-sm leading-relaxed text-muted-foreground">{siteConfig.tagline}</p>
        <ul class="mt-5 flex items-center justify-center gap-2.5 sm:justify-start">
          {
            socials.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="social-btn"
                  aria-label={item.label === "RSS" ? "Feed RSS" : `${siteConfig.name} no ${item.label}`}
                  rel={item.href.startsWith("http") ? "noreferrer" : undefined}
                >
                  <LocalIcon name={item.icon} className="h-[0.95rem] w-[0.95rem]" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        footerNavigation.map((group) => (
          <nav aria-label={`Rodapé — ${group.label}`}>
            <p class="footer-group-title">{group.label}</p>
            <ul class="mt-4 grid gap-3">
              {group.items.map((item) => (
                <li>
                  <a href={item.href} class="nav-link footer-link">{item.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="footer-bottom mt-12 flex flex-col items-center gap-2 border-t border-border pt-6 text-center md:flex-row md:justify-between md:text-left">
      <p class="text-xs text-muted-foreground">&copy; {currentYear} {siteConfig.name}. Todos os direitos reservados.</p>
      <p class="text-xs text-muted-foreground">
        Feito com <a href="https://astro.build/" rel="noreferrer" class="link-quiet underline underline-offset-2">Astro</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .social-btn {
    display: inline-grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid var(--border);
    color: var(--muted-foreground);
    border-radius: var(--radius-full);
    transition:
      border-color var(--duration) var(--ease-out),
      color var(--duration) var(--ease-out),
      transform var(--duration) var(--ease-out);
  }

  .social-btn:hover,
  .social-btn:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    color: var(--accent);
    transform: translateY(-2px);
  }

  .footer-group-title {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--foreground);
  }

  .footer-link {
    font-size: 0.875rem;
    text-transform: none;
    letter-spacing: normal;
  }
</style>
