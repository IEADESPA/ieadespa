---
import { navigation, siteConfig } from "@/config/site";
import type { Post } from "@/lib/posts";
import { buildSearchIndex, SEARCH_GROUPS, GROUP_LABEL_PLURAL } from "@/lib/search";

interface Props {
  posts: Post[];
}

const currentPath = Astro.url.pathname;
/* Inlined so the palette still returns results if /search-index.json fails. */
const searchFallback = (await buildSearchIndex()).slice(0, 12);
const isCurrentPath = (href: string) =>
  currentPath === href || (href !== "/" && currentPath.startsWith(href));
---

<header class="site-header outer">
  <div class="inner flex items-center justify-between gap-6 py-2.5">
    <a href="/" class="wordmark"><img src="/logo-icon.png" alt={siteConfig.name} width="40" height="40" /></a>

    <div class="flex items-center gap-5">
      <nav class="hidden items-center gap-6 md:flex" aria-label="Navegação principal">
        {
          navigation.map((item) => (
            <a
              href={item.href}
              class="nav-link"
              aria-current={isCurrentPath(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-1">
        <a
          href="/busca/"
          class="icon-btn"
          aria-label="Buscar no site"
          aria-haspopup="dialog"
          aria-controls="site-search-dialog"
          data-search-toggle
        >
          <svg aria-hidden="true" class="h-[1.05rem] w-[1.05rem]" viewBox="0 0 24 24" fill="none">
            <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.75" />
            <path d="m16 16 4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
          </svg>
        </a>

        <div class="pwa-install-wrap">
          <button
            type="button"
            class="icon-btn"
            data-pwa-install-btn
            aria-label="Instalar o site como aplicativo"
            title="Instalar o site como aplicativo"
            hidden
          >
            <svg aria-hidden="true" class="h-[1.05rem] w-[1.05rem]" viewBox="0 0 24 24" fill="none">
              <path d="M12 3v12m0 0 4-4m-4 4-4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M5 17v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
            </svg>
          </button>
          <p class="pwa-ios-tip" data-pwa-ios-tip hidden role="tooltip">
            No iPhone/iPad: toque em <strong>Compartilhar</strong> e depois em
            <strong>"Adicionar à Tela de Início"</strong>.
          </p>
        </div>

        <button
          type="button"
          class="icon-btn"
          data-readable-toggle
          aria-pressed="false"
          aria-label="Ativar modo de leitura fácil"
          title="Modo de leitura fácil (texto maior e mais contraste)"
        >
          <span aria-hidden="true" class="readable-icon">A+</span>
        </button>

        <button
          type="button"
          class="theme-switch ml-1"
          role="switch"
          aria-checked="false"
          data-theme-toggle
          aria-label="Ativar modo escuro"
        >
          <span class="theme-switch__knob" aria-hidden="true">
            <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none">
              <path d="M12 4V2M12 22v-2M4 12H2M22 12h-2M5 5 3.5 3.5M20.5 20.5 19 19M19 5l1.5-1.5M3.5 20.5 5 19" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" />
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2.25" />
            </svg>
            <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none">
              <path d="M20 14.2A7.4 7.4 0 0 1 9.8 4a8.6 8.6 0 1 0 10.2 10.2Z" stroke="currentColor" stroke-width="2.25" stroke-linejoin="round" />
            </svg>
          </span>
        </button>

        <button
          type="button"
          class="icon-btn md:hidden"
          aria-controls="mobile-menu-panel"
          aria-expanded="false"
          data-mobile-menu-toggle
        >
          <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
          </svg>
          <span class="sr-only">Abrir menu de navegação</span>
        </button>
      </div>
    </div>
  </div>
</header>

<dialog
  id="site-search-dialog"
  class="search-dialog"
  aria-labelledby="site-search-title"
  aria-describedby="site-search-summary"
  data-search-dialog
>
  <div class="search-panel" data-search-panel data-empty>
    <form action="/busca/" method="get" role="search" aria-label="Busca no site">
      <div class="search-field">
        <svg aria-hidden="true" class="search-field-icon" viewBox="0 0 24 24" fill="none">
          <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.75" />
          <path d="m16 16 4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
        </svg>
        <h2 id="site-search-title" class="sr-only">Buscar em {siteConfig.name}</h2>
        <label class="sr-only" for="site-search-input">Buscar mensagens</label>
        <input
          id="site-search-input"
          name="q"
          type="search"
          class="search-input"
          placeholder="Buscar mensagens, temas, pregadores…"
          autocomplete="off"
          enterkeyhint="search"
          data-search-input
        />
        <button type="button" class="icon-btn shrink-0" aria-label="Fechar busca" data-search-close>
          <svg aria-hidden="true" class="h-[1.1rem] w-[1.1rem]" viewBox="0 0 24 24" fill="none">
            <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
          </svg>
        </button>
      </div>

      <div class="search-filters" data-search-filters role="tablist" aria-label="Filtrar por tipo">
        <button type="button" class="search-filter is-active" data-filter="" role="tab" aria-selected="true" tabindex="0">Tudo</button>
        {
          SEARCH_GROUPS.map((group) => (
            <button type="button" class="search-filter" data-filter={group} role="tab" aria-selected="false" tabindex="-1">
              {GROUP_LABEL_PLURAL[group]}
            </button>
          ))
        }
      </div>

      <div class="search-body">
        <div class="search-body-head">
          <p class="eyebrow" data-search-heading></p>
          <p id="site-search-summary" class="text-xs text-muted-foreground" data-search-summary aria-live="polite"></p>
        </div>
        <div class="search-results" data-search-results></div>
      </div>

      <div class="search-foot" aria-hidden="true">
        <span><kbd>↑</kbd><kbd>↓</kbd> Navegar</span>
        <span><kbd>↵</kbd> Abrir</span>
        <span><kbd data-search-shortcut>Ctrl K</kbd> Alternar</span>
        <span class="ml-auto hidden sm:inline">Enter busca em tudo</span>
      </div>
    </form>
  </div>
</dialog>

<div
  id="mobile-menu-panel"
  class="mobile-menu-panel md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Menu de navegação"
  hidden
>
  <div class="flex items-center justify-between gap-6 border-b border-border px-6 py-4">
    <a href="/" class="wordmark"><img src="/logo-icon.png" alt={siteConfig.name} width="40" height="40" /></a>
    <button type="button" class="icon-btn" data-mobile-menu-close aria-label="Fechar menu de navegação">
      <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none">
        <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav class="px-6 py-4" aria-label="Navegação móvel">
    <ul>
      {
        navigation.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrentPath(item.href) ? "page" : undefined}
              class="block border-b border-border py-4 text-2xl font-semibold tracking-tight aria-[current=page]:text-accent"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script is:inline type="application/json" id="site-search-fallback" set:html={JSON.stringify(searchFallback)} />

<script is:inline>
  (() => {
    const dialog = document.querySelector("[data-search-dialog]");
    const toggle = document.querySelector("[data-search-toggle]");
    const closeButton = dialog?.querySelector("[data-search-close]");
    const shortcutKey = dialog?.querySelector("[data-search-shortcut]");
    const input = dialog?.querySelector("[data-search-input]");
    const results = dialog?.querySelector("[data-search-results]");
    const heading = dialog?.querySelector("[data-search-heading]");
    const summary = dialog?.querySelector("[data-search-summary]");
    const panel = dialog?.querySelector("[data-search-panel]");
    const filters = dialog?.querySelectorAll("[data-filter]");
    const filtersContainer = dialog?.querySelector("[data-search-filters]");
    const fallback = JSON.parse(document.getElementById("site-search-fallback")?.textContent || "[]");
    let index = [];
    let indexPromise;
    let activeGroup = "";

    // "à" -> "a", pra "familia" encontrar "família" e vice-versa.
    const normalize = (value) => value.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();

    if (shortcutKey && /Mac|iPhone|iPad/.test(navigator.userAgent)) {
      shortcutKey.textContent = "⌘ K";
    }

    /* The full index is fetched on first open, so the palette costs nothing on
       pages the reader never searches from. */
    const loadIndex = () => {
      if (index.length > 0) return Promise.resolve(index);

      indexPromise ??= fetch("/search-index.json")
        .then((response) => {
          if (!response.ok) throw new Error("Search index unavailable");
          return response.json();
        })
        .then((items) => {
          index = Array.isArray(items) && items.length > 0 ? items : fallback;
          return index;
        })
        .catch(() => {
          index = fallback;
          return index;
        });

      return indexPromise;
    };

    const escapeHtml = (value) =>
      String(value).replace(/[&<>"']/g, (character) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      })[character]);

    /* Lower is better: an exact title prefix beats a title match, which beats a
       category match, which beats a hit in the excerpt or author name. */
    const rank = (item, query) => {
      const title = normalize(item.title);
      const group = normalize(item.group || "");
      const supporting = normalize([item.excerpt, item.meta].join(" "));

      if (title.startsWith(query)) return 0;
      if (title.includes(query)) return 1;
      if (group.includes(query)) return 2;
      if (supporting.includes(query)) return 3;
      return Number.POSITIVE_INFINITY;
    };

    const resultMarkup = (item) => `
      <a href="${escapeHtml(item.href)}" class="search-result">
        <span class="search-result-title">${escapeHtml(item.title)}</span>
        <span class="search-result-meta">${escapeHtml(item.group)}${item.meta ? ` &middot; ${escapeHtml(item.meta)}` : ""}</span>
      </a>
    `;

    const render = async () => {
      if (!input || !results || !heading || !summary) return;

      const raw = input.value.trim();
      const query = normalize(raw);

      /* Sem texto digitado e sem filtro escolhido, a paleta colapsa pra só o
         campo — mas escolher um filtro (ex. "Eventos") já abre a lista pra
         navegar por categoria, sem precisar digitar nada. */
      if (!query && !activeGroup) {
        panel?.setAttribute("data-empty", "");
        heading.textContent = "";
        summary.textContent = "";
        results.innerHTML = "";
        return;
      }

      panel?.removeAttribute("data-empty");

      const items = await loadIndex();

      /* A newer keystroke may have landed while the index was loading. */
      if (normalize(input.value.trim()) !== query) return;

      const scoped = activeGroup ? items.filter((item) => item.group === activeGroup) : items;

      const matches = query
        ? scoped
            .map((item) => ({ item, score: rank(item, query) }))
            .filter(({ score }) => Number.isFinite(score))
            .sort((a, b) => a.score - b.score)
            .slice(0, 12)
            .map(({ item }) => item)
        : scoped.slice(0, 12);

      const groupLabel = activeGroup ? ` em ${activeGroup}` : "";
      heading.textContent = query ? "Resultados" : "Navegar";
      summary.textContent = query
        ? `${matches.length} ${matches.length === 1 ? "resultado" : "resultados"} para “${raw}”${groupLabel}.`
        : `${matches.length} ${matches.length === 1 ? "item" : "itens"}${groupLabel}.`;
      results.innerHTML =
        matches.length > 0
          ? matches.map(resultMarkup).join("")
          : `<p class="search-empty">Nada encontrado${groupLabel}. Tente um título, tema ou pregador.</p>`;
    };

    const open = () => {
      if (!dialog || !input || typeof dialog.showModal !== "function") return;
      if (!dialog.open) dialog.showModal();
      document.documentElement.classList.add("has-open-search");
      void render();
      window.requestAnimationFrame(() => input.focus());
    };

    const close = () => {
      if (dialog?.open) dialog.close();
    };

    const filterButtons = filters ? Array.from(filters) : [];

    function selecionarFiltro(button, { moveFocusToInput = false } = {}) {
      activeGroup = button.dataset.filter || "";
      filterButtons.forEach((other) => {
        const isActive = other === button;
        other.classList.toggle("is-active", isActive);
        other.setAttribute("aria-selected", String(isActive));
        // Roving tabindex: só a aba selecionada fica no Tab normal da
        // página — as outras só são alcançáveis pelas setas, como o padrão
        // ARIA de abas exige (senão o Tab pularia por todas, uma a uma).
        other.setAttribute("tabindex", isActive ? "0" : "-1");
      });
      void render();
      if (moveFocusToInput) input?.focus();
    }

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => selecionarFiltro(button, { moveFocusToInput: true }));
    });

    /* Padrão ARIA de tabs: seta esquerda/direita move e já ativa o filtro
       vizinho (ativação automática), Home/End pulam pro primeiro/último. */
    filtersContainer?.addEventListener("keydown", (event) => {
      const currentIndex = filterButtons.indexOf(document.activeElement);
      if (currentIndex === -1) return;

      let nextIndex = null;
      if (event.key === "ArrowRight") nextIndex = (currentIndex + 1) % filterButtons.length;
      else if (event.key === "ArrowLeft") nextIndex = (currentIndex - 1 + filterButtons.length) % filterButtons.length;
      else if (event.key === "Home") nextIndex = 0;
      else if (event.key === "End") nextIndex = filterButtons.length - 1;
      else return;

      event.preventDefault();
      const nextButton = filterButtons[nextIndex];
      selecionarFiltro(nextButton);
      nextButton.focus();
    });

    toggle?.addEventListener("click", (event) => {
      if (!dialog || typeof dialog.showModal !== "function") return;
      event.preventDefault();
      open();
    });

    closeButton?.addEventListener("click", close);

    dialog?.addEventListener("close", () => {
      document.documentElement.classList.remove("has-open-search");
      toggle?.focus();
    });

    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog) close();
    });

    input?.addEventListener("input", () => void render());

    input?.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown") return;
      const first = results?.querySelector("a");
      if (!first) return;
      event.preventDefault();
      first.focus();
    });

    results?.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;

      const links = Array.from(results.querySelectorAll("a"));
      const current = links.indexOf(document.activeElement);
      if (current === -1) return;

      event.preventDefault();
      if (event.key === "ArrowDown") (links[current + 1] || links[0])?.focus();
      else if (current === 0) input?.focus();
      else links[current - 1]?.focus();
    });

    document.addEventListener("keydown", (event) => {
      const target = event.target;
      const isEditing =
        target instanceof HTMLElement &&
        (target.matches("input, textarea, select") || target.isContentEditable);
      const isCommandShortcut = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k";
      const isSlashShortcut =
        event.key === "/" && !isEditing && !event.metaKey && !event.ctrlKey && !event.altKey;

      if (!isCommandShortcut && !isSlashShortcut) return;
      event.preventDefault();

      if (dialog?.open && isCommandShortcut) close();
      else open();
    });

    const header = document.querySelector(".site-header");

    if (header) {
      /* Hide on the way down, reveal on the way back up. The threshold keeps
         small scroll jitter and rubber-banding from flickering the header. */
      const revealThreshold = 6;
      let ticking = false;
      let lastY = window.scrollY;

      const updateHeader = () => {
        const y = window.scrollY;
        const delta = y - lastY;

        header.classList.toggle("is-scrolled", y > 8);

        if (y <= 8) {
          header.classList.remove("is-hidden");
        } else if (delta > revealThreshold) {
          header.classList.add("is-hidden");
        } else if (delta < -revealThreshold) {
          header.classList.remove("is-hidden");
        }

        if (Math.abs(delta) > revealThreshold) lastY = y;
        ticking = false;
      };

      updateHeader();
      window.addEventListener(
        "scroll",
        () => {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(updateHeader);
        },
        { passive: true },
      );
    }

    const menuButton = document.querySelector("[data-mobile-menu-toggle]");
    const menuPanel = document.getElementById("mobile-menu-panel");

    if (menuButton && menuPanel) {
      const menuClose = menuPanel.querySelector("[data-mobile-menu-close]");
      const desktopMedia = window.matchMedia("(min-width: 768px)");
      const focusableSelector =
        'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])';
      let inerted = [];

      const setMenuOpen = (isOpen) => {
        menuPanel.hidden = !isOpen;
        menuButton.setAttribute("aria-expanded", String(isOpen));
        document.documentElement.classList.toggle("has-open-menu", isOpen);

        if (isOpen) {
          inerted = Array.from(document.body.children).filter(
            (element) => element !== menuPanel && !element.inert,
          );
          inerted.forEach((element) => {
            element.inert = true;
          });
          window.requestAnimationFrame(() => menuClose?.focus());
        } else {
          inerted.forEach((element) => {
            element.inert = false;
          });
          inerted = [];
        }
      };

      menuButton.addEventListener("click", () => {
        setMenuOpen(menuButton.getAttribute("aria-expanded") !== "true");
      });

      menuPanel.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setMenuOpen(false));
      });

      menuClose?.addEventListener("click", () => {
        setMenuOpen(false);
        menuButton.focus();
      });

      document.addEventListener("keydown", (event) => {
        if (menuPanel.hidden) return;

        if (event.key === "Escape") {
          setMenuOpen(false);
          menuButton.focus();
          return;
        }

        if (event.key !== "Tab") return;

        const focusable = Array.from(menuPanel.querySelectorAll(focusableSelector));
        const first = focusable[0];
        const last = focusable.at(-1);
        if (!first || !last) return;

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });

      desktopMedia.addEventListener("change", (event) => {
        if (event.matches && !menuPanel.hidden) setMenuOpen(false);
      });
    }

    /* Registra o service worker em todo o site (não só quando a pessoa ativa
       notificação de evento) — sem isso, o navegador não considera o site
       instalável na maioria dos casos. Não faz cache nem funciona offline
       (ver public/sw.js), só habilita a instalação. */
    if ("serviceWorker" in navigator) {
      navigator.serviceWorker.register("/sw.js").catch(() => {});
    }

    const isStandalone =
      window.matchMedia("(display-mode: standalone)").matches || navigator.standalone === true;
    const installBtn = document.querySelector("[data-pwa-install-btn]");
    const iosTip = document.querySelector("[data-pwa-ios-tip]");

    if (installBtn && !isStandalone) {
      const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;

      if (isIOS) {
        installBtn.hidden = false;
        installBtn.addEventListener("click", () => {
          if (!iosTip) return;
          iosTip.hidden = !iosTip.hidden;
        });
        document.addEventListener("click", (event) => {
          if (!iosTip || iosTip.hidden) return;
          if (event.target === installBtn || installBtn.contains(event.target)) return;
          if (event.target === iosTip || iosTip.contains(event.target)) return;
          iosTip.hidden = true;
        });
      } else {
        let deferredPrompt = null;

        window.addEventListener("beforeinstallprompt", (event) => {
          event.preventDefault();
          deferredPrompt = event;
          installBtn.hidden = false;
        });

        installBtn.addEventListener("click", async () => {
          if (!deferredPrompt) return;
          installBtn.hidden = true;
          deferredPrompt.prompt();
          await deferredPrompt.userChoice;
          deferredPrompt = null;
        });

        window.addEventListener("appinstalled", () => {
          installBtn.hidden = true;
        });
      }
    }
  })();
</script>

<style>
  .pwa-install-wrap {
    position: relative;
  }

  .pwa-ios-tip {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 30;
    width: max-content;
    max-width: 16rem;
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--card);
    box-shadow: 0 12px 30px rgb(0 0 0 / 18%);
    padding: 0.75rem 0.9rem;
    color: var(--foreground);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .search-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    overflow-y: auto;
    color: var(--foreground);
    border: 0;
    background: transparent;
    padding: clamp(0.75rem, 9vh, 5rem) 1rem 1rem;
  }

  .search-dialog[open] {
    display: grid;
    grid-template-columns: minmax(0, 40rem);
    align-items: start;
    justify-content: center;
  }

  .search-dialog::backdrop {
    background: rgb(0 0 0 / 45%);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .search-panel {
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--card);
    border-radius: var(--radius-md);
    box-shadow: 0 24px 60px rgb(0 0 0 / 22%);
  }

  .search-dialog[open] .search-panel {
    animation: search-in 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid var(--border);
    padding: 0 1rem;
  }

  .search-field-icon {
    width: 1.1rem;
    height: 1.1rem;
    flex: 0 0 auto;
    color: var(--muted-foreground);
  }

  .search-input {
    width: 100%;
    min-width: 0;
    height: 4rem;
    flex: 1;
    border: 0;
    background: transparent;
    color: var(--foreground);
    outline: none;
    padding: 0;
    font: inherit;
    font-size: 1.0625rem;
  }

