---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProgramacaoList from "@/components/ProgramacaoList.astro";
import { siteConfig } from "@/config/site";
import { formatDate, getAllMensagens, postHref, visiblePosts } from "@/lib/posts";
import { getAllProgramacao, sedeProgramacao } from "@/lib/programacao";
import { youtubeThumbnailUrl, youtubeVideoId } from "@/lib/youtube";

const allPosts = visiblePosts(await getAllMensagens());
const sedeSchedule = sedeProgramacao(await getAllProgramacao());

/* Fase 17: essa lista era só um texto fixo dizendo "nenhuma mensagem tem
   vídeo ainda" — a promessa de aparecer "automaticamente aqui" nunca tinha
   sido implementada de verdade. Mesma miniatura do YoutubeFacade, mas sem
   o script de trocar por <iframe>: aqui é só uma vitrine que leva pra
   página da própria mensagem (que já tem o player de verdade). */
const videoPosts = allPosts
  .map((post) => ({ post, videoId: post.data.videoUrl ? youtubeVideoId(post.data.videoUrl) : null }))
  .filter((item): item is { post: (typeof allPosts)[number]; videoId: string } => item.videoId !== null);

/* Formato oficial de embed do YouTube pra "o que estiver ao vivo agora nesse
   canal" — sem precisar saber o ID do vídeo com antecedência. Mostra a
   transmissão em andamento, ou uma tela de espera do próprio YouTube fora
   do horário de culto. */
const canalId = siteConfig.socials.find((s) => s.label === "YouTube")?.href.split("/").pop();
const liveEmbedSrc = canalId ? `https://www.youtube.com/embed/live_stream?channel=${canalId}` : null;
const canalHref = siteConfig.socials.find((s) => s.label === "YouTube")?.href;
---

<BaseLayout
  title="Assista ao vivo"
  description={`Acompanhe os cultos da ${siteConfig.name} ao vivo pelo YouTube, ou veja mensagens já publicadas.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Ao vivo</p>
        <h1 class="pagehead-title">Assista online</h1>
        <p class="pagehead-description">
          Não pode vir pessoalmente? Acompanhe o culto ao vivo pelo YouTube quando houver
          transmissão.
        </p>
      </header>

      {
        liveEmbedSrc && (
          <div class="mt-8 ao-vivo-embed">
            <iframe
              title="Transmissão ao vivo da igreja no YouTube"
              src={liveEmbedSrc}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          </div>
        )
      }
      <p class="mt-3 text-sm text-muted-foreground">
        Fora do horário de culto, o player acima mostra a tela de espera do próprio YouTube. Se
        preferir, {" "}
        <a href={canalHref} target="_blank" rel="noreferrer" class="link-sweep text-accent font-semibold">
          abra direto no canal do YouTube
        </a>.
      </p>

      <section class="mt-12" aria-labelledby="ao-vivo-horarios-heading">
        <h2 id="ao-vivo-horarios-heading" class="section-title">Programação da sede</h2>
        <p class="mt-2 text-sm text-muted-foreground">
          Nem toda reunião abaixo é necessariamente transmitida — confirme com o canal do YouTube
          se o horário que você procura está ao vivo naquele dia.
        </p>
        <div class="mt-4">
          <ProgramacaoList items={sedeSchedule} showScope={false} />
        </div>
      </section>

      {
        videoPosts.length > 0 ? (
          <section class="mt-12" aria-labelledby="ao-vivo-videos-heading">
            <h2 id="ao-vivo-videos-heading" class="section-title">Mensagens em vídeo</h2>
            <div class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {videoPosts.map(({ post, videoId }) => (
                <a href={postHref(post)} class="ao-vivo-video-card link-title">
                  <span class="ao-vivo-video-thumb">
                    <img src={youtubeThumbnailUrl(videoId)} alt="" loading="lazy" />
                    <span class="ao-vivo-video-play" aria-hidden="true">
                      <span class="ao-vivo-video-play-badge">
                        <span class="ao-vivo-video-play-icon" />
                      </span>
                    </span>
                  </span>
                  <span class="link-title__text mt-2 block text-sm font-semibold leading-snug">{post.data.title}</span>
                  <span class="meta mt-1"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></span>
                </a>
              ))}
            </div>
          </section>
        ) : (
          <div class="ao-vivo-pendente mt-12" aria-label="Mensagens em vídeo, ainda sem nenhuma publicada">
            <p class="ao-vivo-pendente-rotulo">Mensagens em vídeo</p>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
              Assim que uma mensagem publicada em <a href="/mensagens/">/mensagens/</a> tiver vídeo
              cadastrado, ela aparece automaticamente aqui. Por enquanto, nenhuma mensagem tem vídeo
              anexado — enquanto isso, veja o histórico completo de transmissões no{" "}
              <a href={canalHref} target="_blank" rel="noreferrer">canal do YouTube</a>.
            </p>
          </div>
        )
      }
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .ao-vivo-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
    background: var(--muted);
  }

  .ao-vivo-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .ao-vivo-video-thumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--muted);
  }

  .ao-vivo-video-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration) var(--ease-out);
  }

  .ao-vivo-video-card:hover .ao-vivo-video-thumb img,
  .ao-vivo-video-card:focus-visible .ao-vivo-video-thumb img {
    transform: scale(1.03);
  }

  .ao-vivo-video-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(0 0 0 / 20%);
  }

  .ao-vivo-video-play-badge {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    background: rgb(0 0 0 / 65%);
    border-radius: 50%;
  }

  .ao-vivo-video-play-icon {
    width: 0;
    height: 0;
    margin-left: 0.2rem;
    border-top: 0.5rem solid transparent;
    border-bottom: 0.5rem solid transparent;
    border-left: 0.8rem solid #fff;
  }

  .ao-vivo-pendente {
    border: 1px dashed var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
  }

  .ao-vivo-pendente-rotulo {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
</style>
