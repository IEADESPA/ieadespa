---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { CRIAR_PEDIDO_CAMISETA_URL, DIRECTUS_URL, fetchItems } from "@/lib/directus";
import { fetchCongregacoesPublicas } from "@/lib/congregacoes";
import { getAllMensagens, visiblePosts } from "@/lib/posts";

interface Lote {
  id: number;
  slug: string;
  nome: string;
  descricao: string | null;
  modelos: string[] | null;
  tamanhos: string[] | null;
  valor_venda: number | null;
  precos_tamanho: Record<string, number> | null;
  limite_uma_por_pessoa: boolean;
  pedidos_ate: string | null;
  evento: { title: string } | null;
  ministerio: { name: string } | null;
  pedir_congregacao: boolean;
}

type TipoPergunta = "texto_curto" | "texto_longo" | "selecao_unica" | "selecao_multipla" | "numero" | "data";

interface Pergunta {
  id: number;
  ordem: number | null;
  label: string;
  tipo: TipoPergunta;
  opcoes: string[] | null;
  obrigatoria: boolean;
}

export async function getStaticPaths() {
  const grupos = await fetchItems<Lote>(
    "camiseta_grupos",
    "filter[ativo][_eq]=true&fields=*,evento.title,ministerio.name",
  );
  return grupos.map((lote) => ({ params: { slug: lote.slug }, props: { lote } }));
}

interface Props {
  lote: Lote;
}

const { lote } = Astro.props;
const allPosts = visiblePosts(await getAllMensagens());
// Vem do sistema de governança (vC.2), não mais do Directus — o valor
// gravado em camiseta_pedidos.congregacao passa a ser o CongregacaoId de lá.
const congregacoes = (await fetchCongregacoesPublicas())
  .map((c) => ({ id: c.congregacaoId, name: c.nome }))
  .sort((a, b) => a.name.localeCompare(b.name, "pt-BR"));
const perguntas = await fetchItems<Pergunta>("perguntas_camiseta", `filter[grupo][_eq]=${lote.id}&sort=ordem`);
const dateFormatter = new Intl.DateTimeFormat(siteConfig.dateLocale, { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });

const prazoEncerrado = lote.pedidos_ate ? new Date(lote.pedidos_ate).getTime() < Date.now() : false;
const tamanhos = lote.tamanhos ?? [];
const modelos = lote.modelos ?? [];

/**
 * Preço por peça pode variar por tamanho (opcional) — tamanho sem preço
 * próprio usa `valor_venda` como padrão (ou é grátis, se nem isso estiver
 * definido). Ver a mesma lógica em `/camisetas/` e no painel de pedidos.
 */
function precoTamanho(tamanho: string | null): number {
  const precos = lote.precos_tamanho ?? {};
  if (tamanho && precos[tamanho] != null) return Number(precos[tamanho]);
  return lote.valor_venda != null ? Number(lote.valor_venda) : 0;
}
const brl = (v: number) => `R$ ${v.toLocaleString("pt-BR", { minimumFractionDigits: 2 })}`;
const precosPorTamanhoVariam = tamanhos.length > 0 && new Set(tamanhos.map((t) => precoTamanho(t))).size > 1;
---

<BaseLayout title={lote.nome} description={lote.descricao ?? `Faça seu pedido de ${lote.nome}.`}>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas camiseta-canvas" data-directus-url={DIRECTUS_URL}>
      <header class="pagehead">
        <p class="eyebrow">{lote.evento?.title ?? lote.ministerio?.name ?? "Camiseta/uniforme"}</p>
        <h1 class="pagehead-title">{lote.nome}</h1>
        {lote.descricao && <p class="pagehead-description">{lote.descricao}</p>}
      </header>

      <ul class="mt-6 grid gap-2 text-sm">
        {precosPorTamanhoVariam ? (
          <li>
            <strong class="text-foreground">Valor por peça:</strong>{" "}
            {tamanhos.map((t, i) => (
              <>
                {i > 0 && " · "}
                {t} — {precoTamanho(t) > 0 ? brl(precoTamanho(t)) : "grátis"}
              </>
            ))}
          </li>
        ) : (
          <li>
            <strong class="text-foreground">Valor por peça:</strong>{" "}
            {precoTamanho(tamanhos[0] ?? null) > 0 ? brl(precoTamanho(tamanhos[0] ?? null)) : "Grátis"}
          </li>
        )}
        {lote.limite_uma_por_pessoa && (
          <li><strong class="text-foreground">Limite:</strong> 1 peça por pessoa</li>
        )}
        {lote.pedidos_ate && (
          <li><strong class="text-foreground">Pedidos até:</strong> {dateFormatter.format(new Date(lote.pedidos_ate))}</li>
        )}
      </ul>

      {
        prazoEncerrado ? (
          <p class="mt-6 text-sm leading-relaxed text-muted-foreground">O prazo para fazer pedido deste lote já encerrou.</p>
        ) : (
          <form class="mt-8 grid gap-4 max-w-lg" data-pedido-form data-lote-id={lote.id}>
            <div class="grid gap-2">
              <label class="text-sm font-semibold" for="pedido-nome">Nome</label>
              <input id="pedido-nome" name="nome" type="text" autocomplete="name" required class="field" />
            </div>
            <div class="grid gap-2">
              <label class="text-sm font-semibold" for="pedido-telefone">Telefone / WhatsApp</label>
              <input id="pedido-telefone" name="telefone" type="tel" autocomplete="tel" required class="field" />
              <p class="text-xs text-muted-foreground">
                É só com esse telefone que você confere depois se já chegou e quanto falta pagar —
                sem senha, em{" "}
                <a href="/meus-pedidos-camiseta/" class="underline underline-offset-2">Meus pedidos</a>.
              </p>
            </div>
            <div class="grid gap-2">
              <label class="text-sm font-semibold" for="pedido-email">E-mail (opcional)</label>
              <input id="pedido-email" name="email" type="email" autocomplete="email" class="field" />
              <p class="text-xs text-muted-foreground">
                Se informar, esse pedido aparece junto com o resto na sua{" "}
                <a href="/minha-conta/" class="underline underline-offset-2">Minha conta</a>.
              </p>
            </div>
            {
              lote.pedir_congregacao !== false && (
                <div class="grid gap-2">
                  <label class="text-sm font-semibold" for="pedido-congregacao">Congregação</label>
                  <select id="pedido-congregacao" class="field">
                    <option value="">— Não informar —</option>
                    {congregacoes.map((c) => <option value={c.id}>{c.name}</option>)}
                  </select>
                </div>
              )
            }

            {
              perguntas.map((pergunta) => (
                <div class="grid gap-2" data-pergunta-field data-pergunta-id={pergunta.id} data-pergunta-tipo={pergunta.tipo}>
                  <label class="text-sm font-semibold" for={`pergunta-${pergunta.id}`}>{pergunta.label}</label>
                  {pergunta.tipo === "texto_longo" ? (
                    <textarea id={`pergunta-${pergunta.id}`} rows="4" required={pergunta.obrigatoria} class="field resize-y" />
                  ) : pergunta.tipo === "numero" ? (
                    <input id={`pergunta-${pergunta.id}`} type="number" required={pergunta.obrigatoria} class="field" />
                  ) : pergunta.tipo === "data" ? (
                    <input id={`pergunta-${pergunta.id}`} type="date" required={pergunta.obrigatoria} class="field" />
                  ) : pergunta.tipo === "selecao_unica" ? (
                    <select id={`pergunta-${pergunta.id}`} required={pergunta.obrigatoria} class="field">
                      <option value="">Selecione…</option>
                      {(pergunta.opcoes ?? []).map((opcao) => <option value={opcao}>{opcao}</option>)}
                    </select>
                  ) : pergunta.tipo === "selecao_multipla" ? (
                    <div class="grid gap-1.5">
                      {(pergunta.opcoes ?? []).map((opcao) => (
                        <label class="contact-checkbox">
                          <input type="checkbox" name={`pergunta-${pergunta.id}-multipla`} value={opcao} />
                          {opcao}
                        </label>
                      ))}
                    </div>
                  ) : (
                    <input id={`pergunta-${pergunta.id}`} type="text" required={pergunta.obrigatoria} class="field" />
                  )}
                </div>
              ))
            }

            <fieldset class="grid gap-2">
              <legend class="text-sm font-semibold">Itens do pedido</legend>
              <div class="grid gap-3" data-itens-lista></div>
              <button type="button" class="btn btn-outline mt-1" data-item-adicionar>+ Adicionar item</button>
            </fieldset>

            <p class="text-sm font-semibold" data-pedido-total></p>

            <div class="flex flex-wrap items-center gap-4">
              <button type="submit" class="btn btn-solid">Fazer pedido</button>
              <p class="text-sm leading-relaxed text-muted-foreground" role="status" aria-live="polite" data-pedido-status />
            </div>
          </form>
        )
      }

      <div class="prose mt-16">
        <p><a href="/camisetas/">&larr; Voltar para Camisetas e uniformes</a></p>
      </div>
    </div>
  </main>
  <SiteFooter />

  {
    !prazoEncerrado && (
      <script
        is:inline
        define:vars={{
          criarPedidoUrl: CRIAR_PEDIDO_CAMISETA_URL,
          loteId: lote.id,
          tamanhos,
          modelos,
          valorVenda: lote.valor_venda,
          precosTamanho: lote.precos_tamanho,
          limiteUmaPorPessoa: lote.limite_uma_por_pessoa === true,
        }}
      >
        const form = document.querySelector("[data-pedido-form]");
        const itensLista = document.querySelector("[data-itens-lista]");
        const totalEl = document.querySelector("[data-pedido-total]");

        // Fase 26 — pré-preenche com o e-mail da Minha Conta, se já logado.
        (() => {
          const contaEmailSalvo = localStorage.getItem("conta_email");
          const inputEmail = document.getElementById("pedido-email");
          if (contaEmailSalvo && inputEmail && !inputEmail.value) inputEmail.value = contaEmailSalvo;
        })();

        // Preço por peça pode variar por tamanho (opcional) — tamanho sem
        // preço próprio usa valorVenda como padrão (ou é grátis, se nem isso
        // estiver definido). Mesma lógica em /camisetas/ e no painel.
        function precoTamanho(tamanho) {
          const precos = precosTamanho || {};
          if (tamanho && precos[tamanho] != null) return Number(precos[tamanho]);
          return valorVenda != null ? Number(valorVenda) : 0;
        }

        // Campanha com "limite de 1 peça por pessoa": só uma linha, sem
        // botão de adicionar outra nem de remover, e quantidade travada em 1
        // (o back-end confere isso de novo — este travamento é só de UX).
        if (limiteUmaPorPessoa) {
          document.querySelector("[data-item-adicionar]")?.setAttribute("hidden", "");
        }

        function linhaItemHtml() {
          const tamanhoOpcoes = tamanhos.length
            ? `<option value="">Tamanho…</option>${tamanhos.map((t) => `<option value="${t}">${t}</option>`).join("")}`
            : `<option value="">—</option>`;
          const modeloOpcoes = modelos.length
            ? `<option value="">Modelo…</option>${modelos.map((m) => `<option value="${m}">${m}</option>`).join("")}`
            : `<option value="">—</option>`;
          const quantidadeHtml = limiteUmaPorPessoa
            ? `<input type="hidden" value="1" data-item-quantidade /><span class="text-sm text-muted-foreground">1 peça</span>`
            : `<input type="number" min="1" value="1" class="field item-qtd" data-item-quantidade title="Quantidade" />`;
          const removerHtml = limiteUmaPorPessoa ? "" : `<button type="button" class="btn btn-outline" data-item-remover>Remover</button>`;
          return `
            <div class="grid gap-2 sm:grid-cols-[1fr_1fr_auto_auto] sm:items-center item-linha">
              <select class="field" data-item-tamanho ${tamanhos.length ? "required" : "disabled"}>${tamanhoOpcoes}</select>
              <select class="field" data-item-modelo ${modelos.length ? "required" : "disabled"}>${modeloOpcoes}</select>
              ${quantidadeHtml}
              ${removerHtml}
            </div>
            <p class="text-xs text-muted-foreground item-linha-preco" data-item-preco></p>
          `;
        }

        function precoLabel(v) {
          return v > 0 ? `R$ ${v.toLocaleString("pt-BR", { minimumFractionDigits: 2 })}` : "grátis";
        }

        function atualizarTotal() {
          const linhas = Array.from(document.querySelectorAll(".item-linha"));
          let totalQtd = 0;
          let totalValor = 0;
          linhas.forEach((linha) => {
            const qtd = Number(linha.querySelector("[data-item-quantidade]")?.value) || 0;
            const tamanho = linha.querySelector("[data-item-tamanho]")?.value || null;
            const preco = precoTamanho(tamanho);
            totalQtd += qtd;
            totalValor += qtd * preco;
            const precoEl = linha.nextElementSibling?.matches("[data-item-preco]") ? linha.nextElementSibling : null;
            if (precoEl) precoEl.textContent = qtd > 0 ? (preco > 0 ? `${precoLabel(preco)}/peça` : "Grátis") : "";
          });
          if (!totalEl) return;
          totalEl.textContent = totalQtd > 0 ? `Total: ${totalQtd} peça(s) — ${precoLabel(totalValor)}` : "";
        }

        itensLista?.insertAdjacentHTML("beforeend", linhaItemHtml());

        document.querySelector("[data-item-adicionar]")?.addEventListener("click", () => {
          itensLista?.insertAdjacentHTML("beforeend", linhaItemHtml());
        });

        itensLista?.addEventListener("click", (event) => {
          if (event.target.matches("[data-item-remover]")) {
            const linhas = document.querySelectorAll(".item-linha");
            if (linhas.length > 1) {
              event.target.closest(".item-linha")?.nextElementSibling?.remove();
              event.target.closest(".item-linha")?.remove();
            }
            atualizarTotal();
          }
        });

        itensLista?.addEventListener("input", atualizarTotal);
        atualizarTotal();

        form?.addEventListener("submit", async (event) => {
          event.preventDefault();
          const data = new FormData(form);
          const button = form.querySelector('button[type="submit"]');
          const status = form.querySelector("[data-pedido-status]");
          const congregacaoEl = document.getElementById("pedido-congregacao");

          const itens = Array.from(document.querySelectorAll(".item-linha"))
            .map((linha) => ({
              tamanho: linha.querySelector("[data-item-tamanho]")?.value || null,
              modelo: linha.querySelector("[data-item-modelo]")?.value || null,
              quantidade: Number(linha.querySelector("[data-item-quantidade]")?.value) || 0,
            }))
            .filter((item) => item.quantidade > 0);

          if (itens.length === 0) {
            if (status) status.textContent = "Adicione pelo menos um item com quantidade.";
            return;
          }

          if (button) button.disabled = true;
          if (status) status.textContent = "Enviando…";

          try {
            // Respostas às perguntas customizadas desta campanha (mesmo padrão
            // de `respostas_inscricao` em eventos) — coletadas do formulário.
            const respostas = [];
            form.querySelectorAll("[data-pergunta-field]").forEach((field) => {
              const perguntaId = Number(field.dataset.perguntaId);
              const tipo = field.dataset.perguntaTipo;
              let valor;

              if (tipo === "selecao_multipla") {
                const marcadas = Array.from(field.querySelectorAll("input[type=checkbox]:checked")).map((el) => el.value);
                valor = marcadas.join(", ");
              } else {
                const input = field.querySelector("input, textarea, select");
                valor = input ? input.value : "";
              }

              if (valor) respostas.push({ pergunta: perguntaId, valor });
            });

            // Pedido + itens + respostas são criados juntos numa Function só
            // (`criar-pedido-camiseta`), que também decide sozinha em qual
            // lote (janela de compra aberta) este pedido entra — a criação
            // direta pelo navegador foi desativada de propósito, pra ninguém
            // conseguir escolher o próprio lote nem criar dois lotes "1" ao
            // mesmo tempo.
            const pedidoRes = await fetch(criarPedidoUrl, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                grupoId: loteId,
                nome: String(data.get("nome")).trim(),
                telefone: String(data.get("telefone") || "").trim(),
                email: String(data.get("email") || "").trim() || null,
                congregacaoId: congregacaoEl && congregacaoEl.value ? Number(congregacaoEl.value) : null,
                itens,
                respostas,
              }),
            });
            if (!pedidoRes.ok) {
              const erro = await pedidoRes.json().catch(() => null);
              throw new Error(erro?.erro || "falha ao criar pedido");
            }

            if (status) status.textContent = "✅ Pedido registrado! Acompanhe em \"Meus pedidos\", com o seu telefone.";
            form.reset();
            document.querySelectorAll(".item-linha, .item-linha-preco").forEach((linha, indice) => { if (indice > 1) linha.remove(); });
            atualizarTotal();
          } catch (err) {
            if (status) status.textContent = (err && err.message && err.message !== "falha ao criar pedido") ? err.message : "Não foi possível enviar agora. Tente novamente em instantes.";
            if (button) button.disabled = false;
          }
        });
      </script>
    )
  }

  <style is:global>
    .camiseta-canvas {
      max-width: 42rem;
    }
    .item-linha {
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 0.75rem;
    }
    .item-qtd {
      width: 5rem;
    }
    .item-linha-preco {
      margin-top: -0.5rem;
    }
  </style>
</BaseLayout>
