---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { VERIFICAR_INSCRICAO_URL, fetchItems } from "@/lib/directus";
import { periodoPorExtenso } from "@/lib/arteEventoRegras";
import { getAllMensagens, visiblePosts } from "@/lib/posts";

/*
 * Certificado (10/11/2026: o desenho novo, em `src/lib/arteEvento.ts`): com o código e o telefone da inscrição, quem teve a presença
 * confirmada vê o certificado na tela e pode baixar o PDF (imprimir), salvar a imagem ou compartilhar (WhatsApp). A aparência, o título,
 * o texto, a carga horária e as assinaturas vêm de `eventos.cracha_config` (aba "Crachá e certificado" do painel do evento).
 */
interface Evento {
  id: number;
  slug: string;
  title: string;
  event_date: string | null;
  end_date: string | null;
  aceita_inscricao: boolean;
  cracha_config?: unknown;
}

export async function getStaticPaths() {
  const events = await fetchItems<Evento>("eventos", "filter[aceita_inscricao][_eq]=true");
  // slug e opcional no Directus - sem essa checagem, evento sem slug ainda
  // definido quebraria o build (mesmo bug corrigido em toda pagina por slug).
  return events.filter((event) => event.slug).map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

interface Props {
  event: Evento;
}

const { event } = Astro.props;
const allPosts = visiblePosts(await getAllMensagens());
const periodoEvento = periodoPorExtenso(event.event_date, event.end_date);
const dataEmissao = periodoPorExtenso(event.end_date || event.event_date, null);
---

<BaseLayout title={`Certificado — ${event.title}`} description="Baixe seu certificado de participação no evento." noindex>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas certificado-canvas">
      <header class="pagehead">
        <p class="eyebrow">Certificado</p>
        <h1 class="pagehead-title">{event.title}</h1>
        <p class="pagehead-description">
          Digite o mesmo código usado no check-in do evento e o telefone da inscrição: o certificado aparece aqui, para baixar em PDF,
          salvar a imagem no celular ou compartilhar.
        </p>
      </header>

      <form
        class="mt-8 grid gap-4 max-w-sm"
        data-certificado-form
        data-evento-id={event.id}
        data-evento-slug={event.slug}
        data-evento-titulo={event.title}
        data-evento-periodo={periodoEvento}
        data-evento-data-emissao={dataEmissao}
        data-cracha-config={JSON.stringify(event.cracha_config ?? null)}
        data-verificar-url={VERIFICAR_INSCRICAO_URL}
        data-site-url={siteConfig.siteUrl}
      >
        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="certificado-codigo">Código de confirmação</label>
          <input
            id="certificado-codigo"
            name="codigo"
            type="text"
            autocomplete="off"
            autocapitalize="characters"
            maxlength="6"
            class="field certificado-codigo-input"
            placeholder="A3F9K2"
          />
        </div>
        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="certificado-telefone">Telefone usado na inscrição</label>
          <input
            id="certificado-telefone"
            name="telefone"
            type="tel"
            autocomplete="tel"
            class="field"
            placeholder="(00) 00000-0000"
          />
          <p class="text-xs text-muted-foreground">
            Confere que o certificado é mesmo seu — evita que alguém baixe usando só o código.
          </p>
        </div>
        <button type="submit" class="btn btn-solid">Ver meu certificado</button>
      </form>

      <p class="mt-6 text-lg font-semibold" data-certificado-resultado role="status" aria-live="polite" />

      <section class="mt-6 arte-pronta" data-certificado-pronto hidden aria-label="Seu certificado">
        <img class="arte-previa arte-previa-deitada" data-certificado-previa alt="Prévia do seu certificado" />
        <div class="mt-4 flex flex-wrap gap-3">
          <button type="button" class="btn btn-solid" data-arte-pdf>Baixar PDF (para imprimir)</button>
          <button type="button" class="btn btn-outline" data-arte-imagem>Salvar imagem</button>
          <button type="button" class="btn btn-outline" data-arte-compartilhar hidden>Compartilhar</button>
        </div>
        <canvas data-certificado-canvas hidden></canvas>
      </section>
    </div>
  </main>
  <SiteFooter />

  <script>
    import { certificadosEmPdf, desenharCertificado, ligarSaida, prepararRecursos } from "@/lib/arteEvento";
    import { nomeDeArquivo, normalizarCertificado, urlVerificacao } from "@/lib/arteEventoRegras";

    const form = document.querySelector<HTMLFormElement>("[data-certificado-form]");
    if (!form) throw new Error("formulário de certificado ausente");

    const eventoId = form.dataset.eventoId;
    const eventoSlug = form.dataset.eventoSlug ?? "";
    const eventoTitulo = form.dataset.eventoTitulo ?? "";
    const eventoPeriodo = form.dataset.eventoPeriodo ?? "";
    const dataEmissao = form.dataset.eventoDataEmissao ?? "";
    const verificarUrl = form.dataset.verificarUrl ?? "";
    const siteUrl = form.dataset.siteUrl ?? "";
    let crachaConfig: unknown = null;
    try {
      crachaConfig = JSON.parse(form.dataset.crachaConfig ?? "null");
    } catch {
      crachaConfig = null;
    }
    const resultado = document.querySelector<HTMLElement>("[data-certificado-resultado]");
    const pronto = document.querySelector<HTMLElement>("[data-certificado-pronto]");
    const previa = document.querySelector<HTMLImageElement>("[data-certificado-previa]");
    const canvas = document.querySelector<HTMLCanvasElement>("[data-certificado-canvas]");
    const codigoInput = document.getElementById("certificado-codigo") as HTMLInputElement;
    const telefoneInput = document.getElementById("certificado-telefone") as HTMLInputElement;
    const avisar = (t: string) => {
      if (resultado) resultado.textContent = t;
    };

    async function mostrarCertificado(nome: string, codigo: string, tipo: string | null) {
      if (!canvas || !previa || !pronto) return;
      const assinaturas = normalizarCertificado(crachaConfig).assinantes.map((a) => a.assinatura);
      const recursos = await prepararRecursos({ assinaturas });
      const host = siteUrl.replace(/^https?:\/\//, "").replace(/\/+$/, "");
      desenharCertificado(
        canvas,
        {
          nome,
          evento: eventoTitulo,
          data: eventoPeriodo,
          dataEmissao,
          tipo,
          codigo,
          urlVerificacao: urlVerificacao(siteUrl, eventoSlug, codigo),
          verificacaoCurta: `${host}/verificar-certificado/${eventoSlug}/`,
        },
        crachaConfig,
        recursos,
      );
      const titulo = `Certificado — ${nome} — ${eventoTitulo}`;
      await ligarSaida({
        canvas,
        previa,
        nomeBase: `certificado-${nomeDeArquivo(nome)}`,
        titulo,
        pdf: () => certificadosEmPdf([canvas], titulo),
        botaoPdf: pronto.querySelector("[data-arte-pdf]"),
        botaoImagem: pronto.querySelector("[data-arte-imagem]"),
        botaoCompartilhar: pronto.querySelector("[data-arte-compartilhar]"),
        avisar,
      });
      pronto.hidden = false;
      pronto.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const codigo = codigoInput.value.trim().toUpperCase();
      const telefone = telefoneInput.value.trim();
      if (!resultado) return;
      if (pronto) pronto.hidden = true;

      if (!telefone) {
        avisar("Digite o telefone usado na inscrição.");
        return;
      }

      avisar("Verificando…");

      try {
        // `detalhes`: traz o tipo de participante (Preletor, Equipe…), que entra no texto do certificado
        const res = await fetch(verificarUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ evento: eventoId, modo: "codigo", codigo, telefone, detalhes: true }),
        });
        const pessoa = await res.json();

        if (!pessoa?.encontrado) {
          avisar("Código ou telefone não conferem. Confira e tente de novo.");
          return;
        }
        if (!pessoa.presente) {
          avisar("Ainda não encontramos sua confirmação de presença nesse evento.");
          return;
        }

        avisar("Preparando o certificado…");
        await mostrarCertificado(pessoa.nome, pessoa.codigo, pessoa.tipoParticipante ?? null);
        avisar(`✅ Certificado de ${pessoa.nome}. Baixe o PDF, salve a imagem ou compartilhe.`);
      } catch {
        avisar("Não foi possível buscar agora. Tente novamente em instantes.");
      }
    });
  </script>

  <style>
    .certificado-canvas {
      max-width: 52rem;
    }

    .certificado-canvas form {
      max-width: 24rem;
    }

    .certificado-codigo-input {
      text-transform: uppercase;
      letter-spacing: 0.2em;
      font-size: 1.5rem;
      text-align: center;
      font-family: var(--font-mono);
    }
  </style>
</BaseLayout>
