---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { getAllMensagens, visiblePosts } from "@/lib/posts";
import { congregacaoMapsQuery, fetchCongregacoesPublicas, type CongregacaoPublica } from "@/lib/congregacoes";

export async function getStaticPaths() {
  const congregacoes = await fetchCongregacoesPublicas();
  // slug é opcional no cadastro — sem essa checagem, uma congregação sem
  // slug ainda definido quebraria o build inteiro.
  return congregacoes
    .filter((congregacao) => congregacao.slug)
    .map((congregacao) => ({ params: { slug: congregacao.slug }, props: { congregacao } }));
}

interface Props {
  congregacao: CongregacaoPublica;
}

const { congregacao } = Astro.props;
const allPosts = visiblePosts(await getAllMensagens());
const mapaQuery = congregacaoMapsQuery(congregacao);
const mapsEmbedSrc = mapaQuery ? `https://www.google.com/maps?q=${encodeURIComponent(mapaQuery)}&output=embed` : null;
---

<BaseLayout
  title={congregacao.nome}
  description={`Endereço e horários da ${congregacao.nome}, congregação da ${siteConfig.name}.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <Breadcrumbs items={[{ label: "Congregações", href: "/congregacoes/" }, { label: congregacao.nome }]} />
        <p class="eyebrow">Congregação</p>
        <h1 class="pagehead-title">{congregacao.nome}</h1>
      </header>

      {(congregacao.endereco || congregacao.bairro) && (
        <p class="text-sm text-muted-foreground">
          {congregacao.endereco}
          {congregacao.endereco && congregacao.bairro && " — "}
          {congregacao.bairro}
          {(congregacao.cidade || congregacao.estado) && (
            <>, {congregacao.cidade} {congregacao.estado && `- ${congregacao.estado}`}</>
          )}
        </p>
      )}

      {congregacao.notaEndereco && (
        <p class="mt-1 text-sm italic text-muted-foreground">{congregacao.notaEndereco}</p>
      )}

      {congregacao.cep && (
        <p class="mt-2 text-xs text-muted-foreground">CEP {congregacao.cep}</p>
      )}

      {congregacao.mapsUrl && (
        <a href={congregacao.mapsUrl} target="_blank" rel="noreferrer" class="mt-4 inline-block link-sweep text-sm font-semibold text-accent">
          Ver rota no Google Maps
        </a>
      )}

      {mapsEmbedSrc && (
        <div class="mt-4 overflow-hidden rounded-[var(--radius-md)] border border-border">
          <iframe
            title={`Mapa com a localização da ${congregacao.nome}`}
            src={mapsEmbedSrc}
            width="100%"
            height="280"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      )}

      {congregacao.dirigenteAtual && (
        <p class="mt-6 text-sm">
          <strong>Dirigente:</strong> {congregacao.dirigenteAtual}
        </p>
      )}

      {congregacao.horarios && (
        <div class="mt-2">
          <p class="text-sm font-semibold">Horários</p>
          <p class="mt-1 whitespace-pre-line text-sm leading-relaxed text-muted-foreground">{congregacao.horarios}</p>
        </div>
      )}

      <div class="prose mt-16">
        <p><a href="/congregacoes/">&larr; Voltar para Congregações</a></p>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
