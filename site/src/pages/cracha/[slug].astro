---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { VERIFICAR_INSCRICAO_URL, fetchItems } from "@/lib/directus";
import { fetchCongregacoesPublicas } from "@/lib/congregacoes";
import { periodoPorExtenso } from "@/lib/arteEventoRegras";
import { getAllMensagens, visiblePosts } from "@/lib/posts";

/*
 * Crachá (10/11/2026: o desenho novo, em `src/lib/arteEvento.ts`): com o código e o telefone da inscrição, o crachá aparece na tela —
 * para mostrar no celular na entrada, salvar a imagem, compartilhar ou baixar o PDF e imprimir (tamanho real, 10,5 × 14,8 cm). O que vai
 * nele (tipo, igreja, cidade, QR) e a aparência vêm de `eventos.cracha_config`, que a verificação devolve junto (`cracha: true`).
 */
interface Evento {
  id: number;
  slug: string;
  title: string;
  description: string | null;
  aceita_inscricao: boolean;
  event_date: string | null;
  end_date: string | null;
  location: string | null;
  congregacao: number | null;
  cover: string | null;
}

export async function getStaticPaths() {
  const events = await fetchItems<Evento>("eventos", "filter[aceita_inscricao][_eq]=true");
  // slug e opcional no Directus - sem essa checagem, evento sem slug ainda
  // definido quebraria o build (mesmo bug corrigido em toda pagina por slug).
  return events.filter((event) => event.slug).map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

interface Props {
  event: Evento;
}

const { event } = Astro.props;
const allPosts = visiblePosts(await getAllMensagens());
// a linha de baixo do topo do crachá: "28 e 29 de novembro · Templo Central" (o local escrito, ou o nome da congregação do evento)
const congregacao = event.congregacao ? (await fetchCongregacoesPublicas()).find((c) => c.congregacaoId === Number(event.congregacao))?.nome ?? null : null;
const subtitulo = [periodoPorExtenso(event.event_date, event.end_date, true), event.location?.trim() || congregacao].filter(Boolean).join(" · ");
---

<BaseLayout title={`Crachá — ${event.title}`} description="Baixe seu crachá de identificação do evento." noindex>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas cracha-canvas">
      <header class="pagehead">
        <p class="eyebrow">Crachá</p>
        <h1 class="pagehead-title">{event.title}</h1>
        <p class="pagehead-description">
          Digite o mesmo código usado no check-in do evento e o telefone da inscrição: o seu crachá aparece aqui, já com o seu nome — para
          mostrar no celular, salvar a imagem, compartilhar ou imprimir.
        </p>
      </header>

      <form
        class="mt-8 grid gap-4 max-w-sm"
        data-cracha-form
        data-evento-id={event.id}
        data-evento-titulo={event.title}
        data-evento-subtitulo={subtitulo}
        data-evento-capa={event.cover ?? ""}
        data-verificar-url={VERIFICAR_INSCRICAO_URL}
      >
        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="cracha-codigo">Código de confirmação</label>
          <input
            id="cracha-codigo"
            name="codigo"
            type="text"
            autocomplete="off"
            autocapitalize="characters"
            maxlength="6"
            class="field cracha-codigo-input"
            placeholder="A3F9K2"
          />
        </div>
        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="cracha-telefone">Telefone usado na inscrição</label>
          <input
            id="cracha-telefone"
            name="telefone"
            type="tel"
            autocomplete="tel"
            class="field"
            placeholder="(00) 00000-0000"
          />
          <p class="text-xs text-muted-foreground">
            Confere que o crachá é mesmo seu — evita que alguém baixe usando só o código.
          </p>
        </div>
        <button type="submit" class="btn btn-solid">Ver meu crachá</button>
      </form>

      <p class="mt-6 text-lg font-semibold" data-cracha-resultado role="status" aria-live="polite" />

      <section class="mt-6 arte-pronta" data-cracha-pronto hidden aria-label="Seu crachá">
        <img class="arte-previa arte-previa-em-pe" data-cracha-previa alt="Prévia do seu crachá" />
        <div class="mt-4 flex flex-wrap gap-3">
          <button type="button" class="btn btn-solid" data-arte-imagem>Salvar imagem</button>
          <button type="button" class="btn btn-outline" data-arte-compartilhar hidden>Compartilhar</button>
          <button type="button" class="btn btn-outline" data-arte-pdf>Baixar PDF (para imprimir)</button>
        </div>
        <p class="mt-2 text-xs text-muted-foreground">
          O PDF sai no tamanho real (10,5 × 14,8 cm), com a linha de corte. No celular, a imagem serve para mostrar na entrada.
        </p>
        <canvas data-cracha-canvas hidden></canvas>
      </section>
    </div>
  </main>
  <SiteFooter />

  <script>
    import { crachasEmPdf, desenharCracha, ligarSaida, prepararRecursos } from "@/lib/arteEvento";
    import { nomeDeArquivo } from "@/lib/arteEventoRegras";
    import { camposDoCracha, normalizarConfigCracha } from "@/lib/cracha";

    const form = document.querySelector<HTMLFormElement>("[data-cracha-form]");
    if (!form) throw new Error("formulário de crachá ausente");

    const eventoId = form.dataset.eventoId;
    const eventoTitulo = form.dataset.eventoTitulo ?? "";
    const eventoSubtitulo = form.dataset.eventoSubtitulo ?? "";
    const eventoCapa = form.dataset.eventoCapa || null;
    const verificarUrl = form.dataset.verificarUrl ?? "";
    const resultado = document.querySelector<HTMLElement>("[data-cracha-resultado]");
    const pronto = document.querySelector<HTMLElement>("[data-cracha-pronto]");
    const previa = document.querySelector<HTMLImageElement>("[data-cracha-previa]");
    const canvas = document.querySelector<HTMLCanvasElement>("[data-cracha-canvas]");
    const codigoInput = document.getElementById("cracha-codigo") as HTMLInputElement;
    const telefoneInput = document.getElementById("cracha-telefone") as HTMLInputElement;
    const avisar = (t: string) => {
      if (resultado) resultado.textContent = t;
    };

    // v7.13 — o crachá segue a configuração do evento (tipo, igreja/congregação, cidade e QR do credenciamento), que a verificação devolve
    // junto com as respostas da própria pessoa (`cracha: true`); 10/11/2026 — e a aparência (cores, a imagem do evento no topo).
    interface DadosCrachaApi {
      config?: unknown;
      tipo?: string | null;
      igreja?: string | null;
      cidade?: string | null;
    }

    async function mostrarCracha(nome: string, codigo: string | null, dados: DadosCrachaApi | null) {
      if (!canvas || !previa || !pronto) return;
      const configBruta = dados?.config ?? null;
      const config = normalizarConfigCracha(configBruta);
      const campos = camposDoCracha(config, { nome, codigo, tipo: dados?.tipo ?? null, igreja: dados?.igreja ?? null, cidade: dados?.cidade ?? null }, eventoId ?? null);
      const recursos = await prepararRecursos({ capa: eventoCapa });
      desenharCracha(
        canvas,
        { nome: campos.nome || nome, evento: eventoTitulo, subtitulo: eventoSubtitulo || null, tipo: campos.tipo, linhas: campos.linhas, qr: campos.qr, codigo: campos.qr ? codigo : null },
        configBruta,
        recursos,
      );
      const titulo = `Crachá — ${nome} — ${eventoTitulo}`;
      await ligarSaida({
        canvas,
        previa,
        nomeBase: `cracha-${nomeDeArquivo(nome)}`,
        titulo,
        pdf: () => crachasEmPdf([canvas], titulo),
        botaoPdf: pronto.querySelector("[data-arte-pdf]"),
        botaoImagem: pronto.querySelector("[data-arte-imagem]"),
        botaoCompartilhar: pronto.querySelector("[data-arte-compartilhar]"),
        avisar,
      });
      pronto.hidden = false;
      pronto.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const codigo = codigoInput.value.trim().toUpperCase();
      const telefone = telefoneInput.value.trim();
      if (!resultado) return;
      if (pronto) pronto.hidden = true;

      if (!telefone) {
        avisar("Digite o telefone usado na inscrição.");
        return;
      }

      avisar("Verificando…");

      try {
        const res = await fetch(verificarUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ evento: eventoId, modo: "codigo", codigo, telefone, cracha: true }),
        });
        const pessoa = await res.json();

        if (!pessoa?.encontrado) {
          avisar("Código ou telefone não conferem. Confira e tente de novo.");
          return;
        }

        avisar("Preparando o crachá…");
        await mostrarCracha(pessoa.nome, pessoa.codigo ?? null, pessoa.cracha ?? null);
        avisar(`✅ Crachá de ${pessoa.nome}. Salve a imagem, compartilhe ou baixe o PDF para imprimir.`);
      } catch {
        avisar("Não foi possível buscar agora. Tente novamente em instantes.");
      }
    });
  </script>

  <style>
    .cracha-canvas {
      max-width: 40rem;
    }

    .cracha-codigo-input {
      text-transform: uppercase;
      letter-spacing: 0.2em;
      font-size: 1.5rem;
      text-align: center;
      font-family: var(--font-mono);
    }
  </style>
</BaseLayout>
