---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { DIRECTUS_URL, fetchItems } from "@/lib/directus";
import { getAllMensagens, visiblePosts } from "@/lib/posts";
import { coordenadaDeLinkMaps } from "@/lib/googleMapsLink";

const allPosts = visiblePosts(await getAllMensagens());

const categorias = [
  { value: "diretoria", label: "Diretoria" },
  { value: "conselho", label: "Conselho" },
  { value: "congregacao", label: "Congregação" },
  { value: "departamento", label: "Departamento/Ministério" },
  { value: "area", label: "Área/Regional" },
  { value: "", label: "Sem categoria definida" },
];

/* Fase 24.5 — resolvido em tempo de build (Node, sem CORS) porque o link do
   Maps às vezes é um link curto (maps.app.goo.gl), e seguir o redirecionamento
   dele direto do navegador de quem exporta o PDF esbarraria em CORS (o
   destino final, google.com/maps/place/..., não libera isso pra leitura via
   fetch de outro site). Só eventos sem congregação têm link próprio (Fase
   24.3) — congregação ainda não entra no critério de mapa confirmado.
   Resultado vira um objeto {id: {lat,lng}} embutido na página, que o script
   do navegador usa direto, sem precisar resolver nada sozinho. */
interface EventoComLink {
  id: number;
  location_maps_url: string | null;
  congregacao: number | null;
}
const eventosComLink = await fetchItems<EventoComLink>(
  "eventos",
  "filter[location_maps_url][_nnull]=true&fields=id,location_maps_url,congregacao",
);
const coordenadasPorEvento: Record<number, { lat: number; lng: number }> = {};
await Promise.all(
  eventosComLink
    .filter((e) => !e.congregacao && e.location_maps_url)
    .map(async (e) => {
      const coordenada = await coordenadaDeLinkMaps(e.location_maps_url!);
      if (coordenada) coordenadasPorEvento[e.id] = coordenada;
    }),
);
---

<BaseLayout
  title="Baixar PDF de eventos"
  description="Escolha o período e o responsável, e baixe um PDF resumido da programação de eventos para imprimir ou compartilhar."
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas exportar-canvas">
      <header class="pagehead">
        <p class="eyebrow">Eventos</p>
        <h1 class="pagehead-title">Baixar PDF de eventos</h1>
        <p class="pagehead-description">
          Escolha o período e quem é responsável pelos eventos, e baixe um PDF resumido — pronto
          pra imprimir ou postar nos grupos. O arquivo é gerado direto no seu navegador.
        </p>
      </header>

      <form
        class="mt-8 grid gap-6 max-w-xl"
        data-exportar-form
        data-directus-url={DIRECTUS_URL}
        data-coordenadas={JSON.stringify(coordenadasPorEvento)}
        data-maps-key={siteConfig.googleMapsEmbedKey}
      >
        <div class="grid gap-2 sm:grid-cols-2">
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="exportar-de">De (mês)</label>
            <input id="exportar-de" type="month" class="field" data-exportar-de />
          </div>
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="exportar-ate">Até (mês)</label>
            <input id="exportar-ate" type="month" class="field" data-exportar-ate />
          </div>
        </div>

        <div class="flex flex-wrap gap-2">
          <button type="button" class="btn btn-outline btn-sm" data-preset="mes">Este mês</button>
          <button type="button" class="btn btn-outline btn-sm" data-preset="trimestre">Próximos 3 meses</button>
          <button type="button" class="btn btn-outline btn-sm" data-preset="ano">Ano inteiro</button>
        </div>

        <fieldset class="grid gap-2">
          <legend class="text-sm font-semibold">Responsável pelo evento</legend>
          <div class="grid gap-2 sm:grid-cols-2">
            {
              categorias.map((categoria) => (
                <label class="flex items-center gap-2 text-sm">
                  <input type="checkbox" value={categoria.value} checked data-exportar-categoria />
                  {categoria.label}
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="grid gap-2">
          <legend class="text-sm font-semibold">Agrupar por</legend>
          <label class="flex items-center gap-2 text-sm">
            <input type="radio" name="exportar-agrupar" value="mes" checked data-exportar-agrupar /> Cronológico (por mês)
          </label>
          <label class="flex items-center gap-2 text-sm">
            <input type="radio" name="exportar-agrupar" value="responsavel" data-exportar-agrupar /> Por responsável (Diretoria, Área, Departamento, Congregação…)
          </label>
        </fieldset>

        <fieldset class="grid gap-2">
          <legend class="text-sm font-semibold">Local no mapa</legend>
          <label class="flex items-center gap-2 text-sm">
            <input type="radio" name="exportar-mapa" value="quando-disponivel" checked data-exportar-mapa /> Mostrar mini-mapa quando o evento tiver
          </label>
          <label class="flex items-center gap-2 text-sm">
            <input type="radio" name="exportar-mapa" value="so-com-mapa" data-exportar-mapa /> Só eventos com mapa
          </label>
          <label class="flex items-center gap-2 text-sm">
            <input type="radio" name="exportar-mapa" value="so-sem-mapa" data-exportar-mapa /> Só eventos sem mapa/local marcado
          </label>
        </fieldset>

        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="exportar-titulo">Título do PDF (opcional)</label>
          <input
            id="exportar-titulo"
            type="text"
            class="field"
            maxlength="80"
            placeholder="Ex.: Programação — Departamento de Jovens"
            data-exportar-titulo
          />
        </div>

        <p class="text-sm text-muted-foreground" data-exportar-contagem role="status" aria-live="polite">
          Carregando eventos…
        </p>

        <button type="submit" class="btn btn-solid" data-exportar-submit disabled>Baixar PDF</button>
      </form>
    </div>
  </main>
  <SiteFooter />

  <script>
    import { jsPDF } from "jspdf";
    import { configurarAcessibilidadePdf } from "@/lib/pdf";

    interface EventoExport {
      id: number;
      title: string;
      event_date: string | null;
      end_date: string | null;
      time: string | null;
      location: string | null;
      location_maps_url: string | null;
      responsavel: string | null;
      tipo_responsavel: string | null;
      congregacao: { name: string } | null;
    }

    interface Coordenada {
      lat: number;
      lng: number;
    }

    const form = document.querySelector<HTMLFormElement>("[data-exportar-form]");
    if (!form) throw new Error("formulário de exportação ausente");

    const directusUrl = form.dataset.directusUrl ?? "";
    const googleMapsKey = form.dataset.mapsKey ?? "";
    // Fase 24.5 — coordenadas já resolvidas em tempo de build (ver frontmatter
    // desta página) — {} se nenhum evento sem congregação tiver link colado.
    const coordenadasPorEvento: Record<number, Coordenada> = JSON.parse(form.dataset.coordenadas || "{}");
    const deInput = form.querySelector<HTMLInputElement>("[data-exportar-de]")!;
    const ateInput = form.querySelector<HTMLInputElement>("[data-exportar-ate]")!;
    const categoriaInputs = form.querySelectorAll<HTMLInputElement>("[data-exportar-categoria]");
    const agruparInputs = form.querySelectorAll<HTMLInputElement>("[data-exportar-agrupar]");
    const mapaInputs = form.querySelectorAll<HTMLInputElement>("[data-exportar-mapa]");
    const tituloInput = form.querySelector<HTMLInputElement>("[data-exportar-titulo]");
    const contagem = form.querySelector<HTMLElement>("[data-exportar-contagem]")!;
    const submitBtn = form.querySelector<HTMLButtonElement>("[data-exportar-submit]")!;

    const agruparPor = () => (Array.from(agruparInputs).find((i) => i.checked)?.value ?? "mes") as "mes" | "responsavel";
    const filtroMapa = () =>
      (Array.from(mapaInputs).find((i) => i.checked)?.value ?? "quando-disponivel") as
        | "quando-disponivel"
        | "so-com-mapa"
        | "so-sem-mapa";

    const mesAtual = () => new Date().toISOString().slice(0, 7);
    const somarMeses = (mesIso: string, n: number) => {
      const [ano, mes] = mesIso.split("-").map(Number);
      const data = new Date(Date.UTC(ano, mes - 1 + n, 1));
      return `${data.getUTCFullYear()}-${String(data.getUTCMonth() + 1).padStart(2, "0")}`;
    };

    deInput.value = mesAtual();
    ateInput.value = somarMeses(mesAtual(), 2);

    document.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const hoje = mesAtual();
        if (btn.dataset.preset === "mes") {
          deInput.value = hoje;
          ateInput.value = hoje;
        } else if (btn.dataset.preset === "trimestre") {
          deInput.value = hoje;
          ateInput.value = somarMeses(hoje, 2);
        } else if (btn.dataset.preset === "ano") {
          deInput.value = `${hoje.slice(0, 4)}-01`;
          ateInput.value = `${hoje.slice(0, 4)}-12`;
        }
        atualizarContagem();
      });
    });

    let eventos: EventoExport[] = [];

    async function carregarEventos() {
      const res = await fetch(
        `${directusUrl}/items/eventos?fields=id,title,event_date,end_date,time,location,location_maps_url,responsavel,tipo_responsavel,congregacao.name&filter[event_date][_nnull]=true&sort=event_date&limit=-1`,
      );
      const json = await res.json();
      eventos = json.data ?? [];
      submitBtn.disabled = false;
      atualizarContagem();
    }

    function categoriasAtivas() {
      return new Set([...categoriaInputs].filter((input) => input.checked).map((input) => input.value));
    }

    function temMapa(evento: EventoExport) {
      return Boolean(coordenadasPorEvento[evento.id]);
    }

    function eventosFiltrados() {
      const de = deInput.value;
      const ate = ateInput.value;
      const ativas = categoriasAtivas();
      const mapa = filtroMapa();
      return eventos.filter((evento) => {
        const mesEvento = (evento.event_date ?? "").slice(0, 7);
        if (de && mesEvento < de) return false;
        if (ate && mesEvento > ate) return false;
        if (!ativas.has(evento.tipo_responsavel ?? "")) return false;
        if (mapa === "so-com-mapa" && !temMapa(evento)) return false;
        if (mapa === "so-sem-mapa" && temMapa(evento)) return false;
        return true;
      });
    }

    function atualizarContagem() {
      const filtrados = eventosFiltrados();
      contagem.textContent =
        filtrados.length === 0
          ? "Nenhum evento encontrado com esses filtros."
          : `${filtrados.length} evento${filtrados.length === 1 ? "" : "s"} selecionado${filtrados.length === 1 ? "" : "s"}.`;
      submitBtn.disabled = filtrados.length === 0;
    }

    [deInput, ateInput, ...categoriaInputs, ...agruparInputs, ...mapaInputs].forEach((el) =>
      el.addEventListener("change", atualizarContagem),
    );

    const dateFormatter = new Intl.DateTimeFormat("pt-BR", { day: "2-digit", month: "2-digit", timeZone: "UTC" });
    const monthFormatter = new Intl.DateTimeFormat("pt-BR", { month: "long", year: "numeric", timeZone: "UTC" });

    const rotuloCategoria: Record<string, string> = {
      diretoria: "Diretoria",
      conselho: "Conselho",
      congregacao: "Congregação",
      departamento: "Departamento/Ministério",
      area: "Área/Regional",
      "": "Sem categoria",
    };
    // Mesma ordem/rótulo do array `categorias` da página (frontmatter Astro,
    // não acessível aqui — script do navegador é um escopo separado).
    const ordemCategorias = ["diretoria", "conselho", "congregacao", "departamento", "area", ""].map((value) => ({
      value,
      label: rotuloCategoria[value],
    }));

    // Cores da identidade visual do site (ver --accent/--accent-strong/
    // --muted-foreground/--border em src/styles/global.css), em RGB pra
    // uso direto no jsPDF.
    const COR_ACCENT: [number, number, number] = [143, 111, 31];
    const COR_ACCENT_ESCURO: [number, number, number] = [107, 84, 23];
    const COR_TEXTO_MUTED: [number, number, number] = [91, 101, 119];
    const COR_BORDA: [number, number, number] = [232, 227, 212];
    const COR_TEXTO: [number, number, number] = [26, 26, 26];

    let logoDataUrl: string | null = null;
    async function carregarLogo(): Promise<string | null> {
      if (logoDataUrl) return logoDataUrl;
      try {
        const res = await fetch("/logo-icon.png");
        const blob = await res.blob();
        logoDataUrl = await new Promise<string>((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve(reader.result as string);
          reader.onerror = reject;
          reader.readAsDataURL(blob);
        });
        return logoDataUrl;
      } catch {
        return null;
      }
    }

    function desenharRodape(doc: InstanceType<typeof jsPDF>, margem: number) {
      const totalPaginas = doc.getNumberOfPages();
      const largura = doc.internal.pageSize.getWidth();
      const altura = doc.internal.pageSize.getHeight();
      for (let i = 1; i <= totalPaginas; i++) {
        doc.setPage(i);
        doc.setDrawColor(...COR_BORDA);
        doc.line(margem, altura - margem + 10, largura - margem, altura - margem + 10);
        doc.setFont("helvetica", "normal");
        doc.setFontSize(8.5);
        doc.setTextColor(...COR_TEXTO_MUTED);
        doc.text("IEADESPA", margem, altura - margem + 24);
        doc.text(`Página ${i} de ${totalPaginas}`, largura - margem, altura - margem + 24, { align: "right" });
      }
    }

    // Fase 24.5 — mini-mapa por evento, buscado só pros eventos que vão
    // realmente aparecer no PDF (não pra todo mundo com link cadastrado) —
    // a Static Maps API libera CORS de verdade (testado), diferente da
    // Geocoding/Autocomplete, então isso roda direto no navegador sem
    // precisar de nenhum passo em tempo de build.
    async function buscarImagemMapa(coordenada: Coordenada): Promise<string | null> {
      try {
        const url = `https://maps.googleapis.com/maps/api/staticmap?center=${coordenada.lat},${coordenada.lng}&zoom=15&size=160x160&markers=color:0x8f6f1f%7C${coordenada.lat},${coordenada.lng}&key=${googleMapsKey}`;
        const res = await fetch(url);
        if (!res.ok) return null;
        const blob = await res.blob();
        return await new Promise<string>((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve(reader.result as string);
          reader.onerror = reject;
          reader.readAsDataURL(blob);
        });
      } catch {
        return null;
      }
    }

    // --- Layout da tabela ---
    const COL_LARGURA = { data: 56, evento: 168, responsavel: 92 };
    const MAPA_TAMANHO = 46;

    function desenharCabecalhoTabela(doc: InstanceType<typeof jsPDF>, margem: number, larguraUtil: number, y: number) {
      const alturaCabecalho = 20;
      doc.setFillColor(...COR_ACCENT);
      doc.rect(margem, y, larguraUtil, alturaCabecalho, "F");
      doc.setFont("helvetica", "bold");
      doc.setFontSize(9.5);
      doc.setTextColor(255, 255, 255);
      let x = margem + 6;
      doc.text("Data", x, y + 13);
      x += COL_LARGURA.data;
      doc.text("Evento", x, y + 13);
      x += COL_LARGURA.evento;
      doc.text("Responsável", x, y + 13);
      x += COL_LARGURA.responsavel;
      doc.text("Local", x, y + 13);
      doc.setTextColor(...COR_TEXTO);
      return y + alturaCabecalho;
    }

    async function desenharLinhaEvento(
      doc: InstanceType<typeof jsPDF>,
      evento: EventoExport,
      margem: number,
      larguraUtil: number,
      y: number,
      alturaPagina: number,
      mostrarMapa: boolean,
      imagensCache: Map<number, string | null>,
    ): Promise<number> {
      const colX = {
        data: margem,
        evento: margem + COL_LARGURA.data,
        responsavel: margem + COL_LARGURA.data + COL_LARGURA.evento,
        local: margem + COL_LARGURA.data + COL_LARGURA.evento + COL_LARGURA.responsavel,
      };
      const larguraLocal = larguraUtil - COL_LARGURA.data - COL_LARGURA.evento - COL_LARGURA.responsavel;

      const dataTexto = evento.event_date ? dateFormatter.format(new Date(evento.event_date)) : "--/--";
      const horaTexto = evento.time ?? "";
      const local = evento.congregacao?.name || evento.location || "—";
      const categoria = rotuloCategoria[evento.tipo_responsavel ?? ""] ?? "—";

      const coordenada = coordenadasPorEvento[evento.id];
      const incluirMapa = mostrarMapa && Boolean(coordenada);

      doc.setFont("helvetica", "normal");
      doc.setFontSize(9);
      const linhasEvento = doc.splitTextToSize(evento.title, COL_LARGURA.evento - 8);
      const linhasResp = doc.splitTextToSize(categoria, COL_LARGURA.responsavel - 8);
      const linhasLocal = doc.splitTextToSize(local, larguraLocal - 8);

      const linhasTexto = Math.max(linhasEvento.length, linhasResp.length, linhasLocal.length, 2);
      const alturaTexto = linhasTexto * 11 + 10;
      const alturaComMapa = incluirMapa ? linhasLocal.length * 11 + MAPA_TAMANHO + 14 : 0;
      const alturaLinha = Math.max(alturaTexto, alturaComMapa);

      if (y + alturaLinha > alturaPagina - margem) {
        doc.addPage();
        y = desenharCabecalhoTabela(doc, margem, larguraUtil, margem);
      }

      doc.setDrawColor(...COR_BORDA);
      doc.rect(margem, y, larguraUtil, alturaLinha);
      [colX.evento, colX.responsavel, colX.local].forEach((x) => doc.line(x, y, x, y + alturaLinha));

      doc.setTextColor(...COR_TEXTO);
      doc.text(dataTexto, colX.data + 4, y + 12);
      if (horaTexto) doc.text(horaTexto, colX.data + 4, y + 23);

      doc.text(linhasEvento, colX.evento + 4, y + 12);
      doc.setTextColor(...COR_TEXTO_MUTED);
      doc.text(linhasResp, colX.responsavel + 4, y + 12);
      doc.setTextColor(...COR_TEXTO);
      doc.text(linhasLocal, colX.local + 4, y + 12);

      if (incluirMapa && coordenada) {
        if (!imagensCache.has(evento.id)) imagensCache.set(evento.id, await buscarImagemMapa(coordenada));
        const imagem = imagensCache.get(evento.id);
        const mapaY = y + linhasLocal.length * 11 + 8;
        if (imagem) {
          doc.addImage(imagem, "PNG", colX.local + 4, mapaY, MAPA_TAMANHO, MAPA_TAMANHO);
          if (evento.location_maps_url) {
            doc.link(colX.local + 4, mapaY, MAPA_TAMANHO, MAPA_TAMANHO, { url: evento.location_maps_url });
          }
        }
      }

      return y + alturaLinha;
    }

    async function gerarPdf() {
      const filtrados = eventosFiltrados();
      if (filtrados.length === 0) return;

      const mostrarMapa = filtroMapa() !== "so-sem-mapa";
      const imagensCache = new Map<number, string | null>();

      const logo = await carregarLogo();
      const doc = new jsPDF({ unit: "pt", format: "a4" });
      const margem = 48;
      const larguraUtil = doc.internal.pageSize.getWidth() - margem * 2;
      const alturaPagina = doc.internal.pageSize.getHeight();
      let y = margem;

      if (logo) doc.addImage(logo, "PNG", margem, y - 22, 26, 26);
      const inicioTitulo = logo ? margem + 34 : margem;

      const tituloPersonalizado = tituloInput?.value.trim();
      configurarAcessibilidadePdf(doc, tituloPersonalizado || "Programação de eventos");
      doc.setFont("helvetica", "bold");
      doc.setFontSize(16);
      doc.setTextColor(...COR_ACCENT_ESCURO);
      doc.text(tituloPersonalizado || "Programação de eventos", inicioTitulo, y);
      y += 20;

      doc.setDrawColor(...COR_ACCENT);
      doc.setLineWidth(1.5);
      doc.line(margem, y, doc.internal.pageSize.getWidth() - margem, y);
      y += 18;

      doc.setFont("helvetica", "normal");
      doc.setFontSize(10);
      doc.setTextColor(...COR_TEXTO_MUTED);
      doc.text(`${deInput.value} a ${ateInput.value} · gerado em ${new Date().toLocaleDateString("pt-BR")}`, margem, y);
      y += 20;
      doc.setTextColor(...COR_TEXTO);

      // Agrupamento: cronológico (mês) já vem ordenado por event_date do
      // Directus; por responsável usa a mesma ordem/rótulos já cadastrados
      // (Diretoria → Conselho → Congregação → Departamento → Área → sem
      // categoria), cada grupo em ordem cronológica por dentro.
      const grupos: { label: string; itens: EventoExport[] }[] = [];
      if (agruparPor() === "responsavel") {
        ordemCategorias.forEach((c) => {
          const itens = filtrados.filter((e) => (e.tipo_responsavel ?? "") === c.value);
          if (itens.length) grupos.push({ label: c.label, itens });
        });
      } else {
        let grupoAtual: { label: string; itens: EventoExport[] } | null = null;
        filtrados.forEach((evento) => {
          const label = evento.event_date ? monthFormatter.format(new Date(evento.event_date)) : "Sem data";
          if (!grupoAtual || grupoAtual.label !== label) {
            grupoAtual = { label, itens: [] };
            grupos.push(grupoAtual);
          }
          grupoAtual.itens.push(evento);
        });
      }

      for (const grupo of grupos) {
        if (y > alturaPagina - margem - 80) {
          doc.addPage();
          y = margem;
        }
        y += 6;
        doc.setFillColor(...COR_ACCENT);
        doc.rect(margem, y - 10, 3, 13, "F");
        doc.setFont("helvetica", "bold");
        doc.setFontSize(12);
        doc.setTextColor(...COR_ACCENT_ESCURO);
        const rotuloGrupo = grupo.label.charAt(0).toUpperCase() + grupo.label.slice(1);
        doc.text(rotuloGrupo, margem + 10, y);
        doc.setTextColor(...COR_TEXTO);
        y += 14;

        y = desenharCabecalhoTabela(doc, margem, larguraUtil, y);

        for (const evento of grupo.itens) {
          y = await desenharLinhaEvento(doc, evento, margem, larguraUtil, y, alturaPagina, mostrarMapa, imagensCache);
        }
        y += 14;
      }

      desenharRodape(doc, margem);

      const nomeArquivo = `eventos-${deInput.value}-a-${ateInput.value}.pdf`;
      doc.save(nomeArquivo);
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      submitBtn.disabled = true;
      const textoOriginal = submitBtn.textContent;
      submitBtn.textContent = "Gerando PDF…";
      try {
        await gerarPdf();
      } finally {
        submitBtn.textContent = textoOriginal;
        atualizarContagem();
      }
    });

    carregarEventos().catch(() => {
      contagem.textContent = "Não foi possível carregar os eventos agora.";
    });

    atualizarContagem();
  </script>
