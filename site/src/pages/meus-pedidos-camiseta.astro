---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { CONSULTAR_PEDIDOS_CAMISETA_URL } from "@/lib/directus";
import { getAllMensagens, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getAllMensagens());
---

<BaseLayout
  title="Meus pedidos de camiseta"
  description="Confira o andamento do seu pedido de camiseta/uniforme, só com o telefone."
  noindex
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas meus-pedidos-canvas">
      <header class="pagehead">
        <p class="eyebrow">Camisetas e uniformes</p>
        <h1 class="pagehead-title">Meus pedidos</h1>
        <p class="pagehead-description">
          Digite o telefone usado no pedido pra ver o tamanho, se já chegou e quanto falta pagar —
          sem senha nenhuma.
        </p>
      </header>

      <form class="mt-8 grid gap-4 max-w-sm" data-consulta-form data-consulta-url={CONSULTAR_PEDIDOS_CAMISETA_URL}>
        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="consulta-telefone">Telefone / WhatsApp</label>
          <input id="consulta-telefone" name="telefone" type="tel" autocomplete="tel" required class="field" />
        </div>
        <div class="grid gap-2" data-consulta-nome-bloco hidden>
          <label class="text-sm font-semibold" for="consulta-nome">Nome usado no pedido</label>
          <input id="consulta-nome" name="nome" type="text" autocomplete="name" class="field" />
          <p class="text-xs text-muted-foreground">Pedidos feitos até 06/10/2026 precisam também do nome (ou parte dele) que você escreveu no pedido.</p>
        </div>
        <button type="submit" class="btn btn-solid">Consultar</button>
      </form>

      <div class="mt-8" data-consulta-resultado></div>
    </div>
  </main>
  <SiteFooter />

  <script>
    interface Item {
      tamanho: string | null;
      modelo: string | null;
      quantidade: number;
      valorUnitario: number;
      quantidadePaga: number;
      quantidadeRetirada: number;
    }

    interface Pedido {
      lote: string | null;
      nome: string | null;
      criadoEm: string | null;
      loteNumero: number | null;
      loteStatus: "aberto" | "fechado" | null;
      loteFechadoEm: string | null;
      valorTotal: number;
      valorPago: number;
      separado: boolean;
      separadoEm: string | null;
      retiradaLocal: string | null;
      mensagemRetirada: string | null;
      itens: Item[];
    }

    const form = document.querySelector<HTMLFormElement>("[data-consulta-form]");
    if (!form) throw new Error("formulário de consulta ausente");

    const consultaUrl = form.dataset.consultaUrl ?? "";
    const telefoneInput = document.getElementById("consulta-telefone") as HTMLInputElement;
    const nomeInput = document.getElementById("consulta-nome") as HTMLInputElement;
    const nomeBloco = document.querySelector<HTMLElement>("[data-consulta-nome-bloco]");
    const resultado = document.querySelector<HTMLElement>("[data-consulta-resultado]");

    function escapeHtml(value: string) {
      return String(value).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] ?? c);
    }

    function situacaoPagamento(p: Pedido): string {
      const total = p.valorTotal;
      if (total <= 0) return "";
      if (p.valorPago >= total) return "Pago";
      if (p.valorPago > 0) {
        return `Pago parcial (R$ ${p.valorPago.toLocaleString("pt-BR", { minimumFractionDigits: 2 })} de R$ ${total.toLocaleString("pt-BR", { minimumFractionDigits: 2 })})`;
      }
      return "Fiado — nada pago ainda";
    }

    function situacaoItem(i: Item): string {
      if (i.quantidadeRetirada >= i.quantidade) return "Todas as peças já retiradas";
      if (i.quantidadeRetirada > 0) return `${i.quantidadeRetirada} de ${i.quantidade} já retiradas`;
      if (i.quantidadePaga > 0) return `${i.quantidadePaga} paga(s), aguardando retirada`;
      return "Aguardando pagamento";
    }

    function itemLinhaHtml(i: Item): string {
      const rotulo = [i.tamanho, i.modelo].filter((v): v is string => Boolean(v)).map(escapeHtml).join(" · ") || "Item";
      const preco = i.valorUnitario > 0 ? `R$ ${i.valorUnitario.toLocaleString("pt-BR", { minimumFractionDigits: 2 })}` : "Grátis";
      return `<li>${rotulo} — ${i.quantidade}x (${preco}) — ${escapeHtml(situacaoItem(i))}</li>`;
    }

    function tudoRetirado(p: Pedido): boolean {
      return p.itens.length > 0 && p.itens.every((i) => i.quantidadeRetirada >= i.quantidade);
    }

    function dataCurta(iso: string | null): string {
      if (!iso) return "";
      const d = new Date(iso);
      return Number.isNaN(d.getTime()) ? "" : d.toLocaleDateString("pt-BR", { timeZone: "America/Belem" });
    }

    // Andamento completo AQUI, não só no e-mail: a maioria dos pedidos não tem e-mail, e a
    // página é o que a pessoa abre com o telefone (pedido do responsável, 06/10/2026).
    // Etapas: recebido → encomendado (lote fechado) → chegou e separado → retirado.
    function etapasHtml(p: Pedido): string {
      const retirado = tudoRetirado(p);
      const etapas: { titulo: string; feito: boolean; detalhe: string }[] = [
        { titulo: "Pedido recebido", feito: true, detalhe: p.criadoEm ? `em ${dataCurta(p.criadoEm)}` : "" },
        {
          titulo: "Encomendado à malharia",
          feito: p.loteStatus === "fechado",
          detalhe: p.loteStatus === "fechado"
            ? `lote ${p.loteNumero ?? ""} fechado${p.loteFechadoEm ? ` em ${dataCurta(p.loteFechadoEm)}` : ""}`
            : p.loteNumero ? `você está no lote ${p.loteNumero}, que ainda está recebendo pedidos` : "",
        },
        { titulo: "Chegou e foi separado", feito: p.separado, detalhe: p.separado ? (p.separadoEm ? `em ${dataCurta(p.separadoEm)}` : "") : "avisaremos aqui quando chegar" },
        { titulo: "Retirado", feito: retirado, detalhe: retirado ? "tudo retirado" : p.separado ? "pronto pra retirar" : "" },
      ];
      return `<ol class="camiseta-etapas">${etapas
        .map((e) => `<li class="${e.feito ? "is-feita" : ""}"><span class="camiseta-etapa-marca" aria-hidden="true">${e.feito ? "✓" : "•"}</span><span><strong>${escapeHtml(e.titulo)}</strong>${e.detalhe ? ` <span class="text-muted-foreground">— ${escapeHtml(e.detalhe)}</span>` : ""}</span></li>`)
        .join("")}</ol>`;
    }

    function pedidoCardHtml(p: Pedido): string {
      const pronto = p.separado && !tudoRetirado(p);
      const avisoRetirada = pronto ? `<p class="camiseta-pedido-pronto">✅ Pronto pra retirar!</p>` : "";
      const ondeRetirar = p.retiradaLocal
        ? `<p class="camiseta-pedido-detalhe"><strong>Onde retirar:</strong> ${escapeHtml(p.retiradaLocal)}</p>`
        : "";
      const mensagem = pronto && p.mensagemRetirada ? `<p class="camiseta-pedido-detalhe">${escapeHtml(p.mensagemRetirada)}</p>` : "";
      const falta = Math.max(p.valorTotal - (p.valorPago || 0), 0);
      const pagamento = p.valorTotal > 0
        ? `<p class="camiseta-pedido-detalhe"><strong>Pagamento:</strong> ${escapeHtml(situacaoPagamento(p))}${falta > 0 ? ` — falta R$ ${falta.toLocaleString("pt-BR", { minimumFractionDigits: 2 })}` : ""}</p>`
        : "";
      return `
        <div class="camiseta-pedido-card">
          <p class="camiseta-pedido-lote">${escapeHtml(p.lote ?? "Pedido")}${p.nome ? ` <span class="font-normal text-muted-foreground">· ${escapeHtml(p.nome)}</span>` : ""}</p>
          ${avisoRetirada}
          ${etapasHtml(p)}
          ${mensagem}
          ${ondeRetirar}
          <ul class="camiseta-pedido-itens">${p.itens.map(itemLinhaHtml).join("")}</ul>
          ${pagamento}
        </div>
      `;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!resultado) return;
      const telefone = telefoneInput.value.trim();
      if (!telefone) return;

      resultado.innerHTML = `<p class="text-sm text-muted-foreground">Consultando…</p>`;
      const nome = nomeBloco && !nomeBloco.hidden ? nomeInput.value.trim() : "";

      try {
        const res = await fetch(consultaUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(nome ? { telefone, nome } : { telefone }),
        });
        if (res.status === 429) {
          resultado.innerHTML = `<p class="text-sm text-muted-foreground">Muitas consultas deste mesmo acesso em poucos minutos. Aguarde um pouco e tente de novo.</p>`;
          return;
        }
        const json = await res.json();
        const pedidos: Pedido[] = json?.pedidos ?? [];

        if (pedidos.length === 0) {
          // Pedido antigo (antes de 06/10/2026) só é localizado com telefone + nome.
          if (json?.precisaNome && nomeBloco) {
            nomeBloco.hidden = false;
            nomeInput.focus();
            resultado.innerHTML = `<p class="text-sm text-muted-foreground">Informe também o nome usado no pedido e consulte de novo.</p>`;
            return;
          }
          resultado.innerHTML = `<p class="text-sm text-muted-foreground">Nenhum pedido encontrado com ${nome ? "esse telefone e esse nome" : "esse telefone"}.</p>`;
          return;
        }

        resultado.innerHTML = `<div class="grid gap-4 sm:grid-cols-2">${pedidos.map(pedidoCardHtml).join("")}</div>`;
      } catch {
        resultado.innerHTML = `<p class="text-sm text-muted-foreground">Não foi possível consultar agora. Tente novamente em instantes.</p>`;
      }
    });
  </script>

  <style is:global>
    .meus-pedidos-canvas {
      max-width: 40rem;
    }
    .camiseta-pedido-card {
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1rem 1.25rem;
    }
    .camiseta-pedido-lote {
      font-weight: 600;
    }
    .camiseta-pedido-pronto {
      margin-top: 0.25rem;
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--accent);
    }
    .camiseta-pedido-detalhe {
      margin-top: 0.25rem;
      font-size: 0.875rem;
      color: var(--muted-foreground);
    }
    .camiseta-pedido-itens {
      margin: 0.5rem 0 0;
      padding-left: 1.1rem;
      font-size: 0.875rem;
      color: var(--muted-foreground);
    }
    .camiseta-etapas {
      list-style: none;
      margin: 0.75rem 0 0;
      padding: 0;
      display: grid;
      gap: 0.35rem;
      font-size: 0.875rem;
    }
    .camiseta-etapas li {
      display: flex;
      gap: 0.5rem;
      align-items: baseline;
      color: var(--muted-foreground);
    }
    .camiseta-etapas li.is-feita {
      color: var(--foreground);
    }
    .camiseta-etapa-marca {
      display: inline-flex;
      width: 1.25rem;
      height: 1.25rem;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      border: 1px solid var(--border);
      font-size: 0.75rem;
      flex: none;
    }
    .camiseta-etapas li.is-feita .camiseta-etapa-marca {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }
  </style>
</BaseLayout>
