---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { DIRECTUS_URL } from "@/lib/directus";
import { getAllMensagens, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getAllMensagens());
---

<BaseLayout title="Gestão de camisetas" description="Área restrita da equipe." noindex>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas" data-directus-url={DIRECTUS_URL}>
      <header class="pagehead">
        <p class="eyebrow">Área restrita</p>
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h1 class="pagehead-title">Gestão de camisetas</h1>
          <p class="text-sm text-muted-foreground" data-painel-usuario-wrap hidden>
            <span data-painel-usuario></span> ·{" "}
            <button type="button" class="link-sweep text-accent font-semibold" data-painel-sair>Sair</button>
          </p>
        </div>
        <p class="pagehead-description" data-painel-carregando>Verificando sua sessão…</p>
      </header>

      <div hidden data-painel-conteudo>
        <p class="mt-4 text-sm">
          <a href="/painel-eventos/lgpd/" class="link-sweep font-semibold text-accent">Exclusão de dados pessoais (LGPD) →</a>
        </p>

        <div class="mt-8" data-dashboard-wrap hidden>
          <h2 class="section-title">Dashboard consolidado</h2>
          <p class="mt-1 text-sm text-muted-foreground">Somando todas as campanhas, ativas e inativas.</p>

          <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div class="stat-card"><p class="stat-numero" data-dstat="vendido">R$ 0</p><p class="stat-label">Vendido</p></div>
            <div class="stat-card"><p class="stat-numero" data-dstat="arrecadado">R$ 0</p><p class="stat-label">Arrecadado</p></div>
            <div class="stat-card"><p class="stat-numero" data-dstat="pago">R$ 0</p><p class="stat-label">Pago à malharia</p></div>
            <div class="stat-card"><p class="stat-numero" data-dstat="saldo">R$ 0</p><p class="stat-label">Saldo</p></div>
          </div>

          <div class="mt-4 grid gap-4 sm:grid-cols-3">
            <div class="stat-card"><p class="stat-numero" data-dstat="pedidas">0</p><p class="stat-label">Peças pedidas</p></div>
            <div class="stat-card"><p class="stat-numero" data-dstat="aguardando">0</p><p class="stat-label">Separadas, aguardando retirada</p></div>
            <div class="stat-card"><p class="stat-numero" data-dstat="retiradas">0</p><p class="stat-label">Já retiradas</p></div>
          </div>

          <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
            <h3 class="text-sm font-semibold">Por campanha</h3>
            <button type="button" class="btn btn-outline" data-exportar-relatorio-pdf>Exportar relatório PDF</button>
          </div>
          <div class="mt-3 overflow-x-auto">
            <table class="tabela-camiseta">
              <thead><tr><th>Campanha</th><th>Vendido</th><th>Arrecadado</th><th>Saldo</th><th>Peças pendentes</th></tr></thead>
              <tbody data-dashboard-corpo></tbody>
            </table>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap items-baseline justify-between gap-3">
          <h2 class="section-title">Lotes de camiseta/uniforme</h2>
          <button type="button" class="btn btn-solid" data-painel-novo-grupo>+ Nova camiseta</button>
        </div>
        <p class="mt-2 text-sm text-muted-foreground" data-painel-novo-status role="status" aria-live="polite"></p>

        <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-painel-lotes-lista>
          <p class="text-sm text-muted-foreground">Carregando lotes…</p>
        </div>
      </div>
    </div>
  </main>
  <SiteFooter />

  <script>
    import { exigirAutenticacao, sair } from "@/lib/painelAuth";
    import { jsPDF } from "jspdf";
    import { configurarAcessibilidadePdf } from "@/lib/pdf";

    const AUTH = { tokenKey: "painel_camisetas_token", loginPath: "/painel-camisetas/entrar/" };

    interface LoteResumo {
      id: number;
      nome: string;
      ativo: boolean;
      valor_venda: number | null;
      precos_tamanho: Record<string, number> | null;
    }

    interface Pedido {
      id: number;
      grupo: number;
      lote: number | null;
      valor_pago: number;
      avulso: boolean;
      separado: boolean;
    }

    interface Item {
      id: number;
      pedido: number;
      tamanho: string | null;
      modelo: string | null;
      quantidade: number;
      quantidade_retirada: number;
    }

    interface Lote {
      id: number;
      grupo: number;
      status: "aberto" | "fechado";
      total_vendido: number | null;
      total_arrecadado: number | null;
      total_pago_malharia: number | null;
    }

    interface LoteItem {
      id: number;
      lote: number;
      tamanho: string | null;
      modelo: string | null;
      estoque_extra: number;
      custo_unitario: number | null;
    }

    const container = document.querySelector<HTMLElement>("[data-directus-url]");
    if (!container) throw new Error("contêiner do painel ausente");
    const directusUrl = container.dataset.directusUrl ?? "";

    const carregando = document.querySelector<HTMLElement>("[data-painel-carregando]");
    const conteudo = document.querySelector<HTMLElement>("[data-painel-conteudo]");
    const usuarioWrap = document.querySelector<HTMLElement>("[data-painel-usuario-wrap]");
    const usuarioEl = document.querySelector<HTMLElement>("[data-painel-usuario]");
    const sairBtn = document.querySelector<HTMLButtonElement>("[data-painel-sair]");
    const listaEl = document.querySelector<HTMLElement>("[data-painel-lotes-lista]");
    const novoBtn = document.querySelector<HTMLButtonElement>("[data-painel-novo-grupo]");

    let token = "";
    let grupos: LoteResumo[] = [];
    let pedidos: Pedido[] = [];
    let itens: Item[] = [];
    let lotes: Lote[] = [];
    let loteItens: LoteItem[] = [];

    function escapeHtml(value: string) {
      return String(value).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] ?? c);
    }
    const brl = (v: number) => `R$ ${v.toLocaleString("pt-BR", { minimumFractionDigits: 2 })}`;

    async function carregarLotes() {
      if (!listaEl) return;
      const res = await fetch(
        `${directusUrl}/items/camiseta_grupos?fields=id,nome,ativo,valor_venda,precos_tamanho&sort=-date_created&limit=-1`,
        { headers: { Authorization: `Bearer ${token}` } },
      );
      const json = await res.json();
      grupos = json.data ?? [];

      if (!grupos.length) {
        listaEl.innerHTML = `<p class="text-sm text-muted-foreground">Nenhum lote ainda. Crie o primeiro acima.</p>`;
        return;
      }

      listaEl.innerHTML = grupos
        .map(
          (lote) => `
            <a href="/painel-camisetas/grupo/?id=${lote.id}" class="painel-evento-card painel-evento-link">
              <span class="painel-evento-titulo">${escapeHtml(lote.nome)}</span>
              <span class="painel-evento-data">${lote.ativo ? "Ativo" : "Inativo"}</span>
            </a>
          `,
        )
        .join("");
    }

    /**
     * Preço por peça pode variar por tamanho (opcional) — mesma lógica já
     * usada em /camisetas/, /camiseta/[slug]/ e no painel de pedidos.
     */
    function precoTamanho(grupo: LoteResumo | undefined, tamanho: string | null): number {
      if (!grupo) return 0;
      const precos = grupo.precos_tamanho ?? {};
      if (tamanho && precos[tamanho] != null) return Number(precos[tamanho]);
      return grupo.valor_venda != null ? Number(grupo.valor_venda) : 0;
    }

    function totalPedido(pedido: Pedido): number {
      const grupo = grupos.find((g) => g.id === pedido.grupo);
      return itens.filter((i) => i.pedido === pedido.id).reduce((s, i) => s + i.quantidade * precoTamanho(grupo, i.tamanho), 0);
    }

    /**
     * "Vendido"/"Arrecadado" de um lote fechado vêm de um retrato congelado
     * (mesmo critério já usado em `grupo/pedidos.astro` — dinheiro já pago à
     * malharia não muda mais); lote aberto calcula ao vivo. Aqui só soma um
     * nível acima (por campanha, não por lote).
     */
    function vendidoArrecadadoLote(lote: Lote): { vendido: number; arrecadado: number } {
      if (lote.status === "fechado" && lote.total_vendido != null) {
        return { vendido: Number(lote.total_vendido), arrecadado: Number(lote.total_arrecadado ?? 0) };
      }
      const pedidosDoLote = pedidos.filter((p) => p.lote === lote.id && !p.avulso);
      return {
        vendido: pedidosDoLote.reduce((s, p) => s + totalPedido(p), 0),
        arrecadado: pedidosDoLote.reduce((s, p) => s + Number(p.valor_pago || 0), 0),
      };
    }

    /** "Pago à malharia" de um lote — congelado se fechado, ao vivo (estoque a encomendar × custo) se aberto. */
    function pagoMalhariaLote(lote: Lote): number {
      if (lote.status === "fechado" && lote.total_pago_malharia != null) return Number(lote.total_pago_malharia);
      const pedidosDoLote = pedidos.filter((p) => p.lote === lote.id && !p.avulso);
      return loteItens
        .filter((li) => li.lote === lote.id)
        .reduce((soma, li) => {
          const pedidoSistema = pedidosDoLote.reduce((s, p) => {
            const itensCombo = itens.filter(
              (i) => i.pedido === p.id && (i.tamanho ?? null) === (li.tamanho ?? null) && (i.modelo ?? null) === (li.modelo ?? null),
            );
            return s + itensCombo.reduce((s2, i) => s2 + i.quantidade, 0);
          }, 0);
          return soma + (pedidoSistema + Number(li.estoque_extra || 0)) * Number(li.custo_unitario || 0);
        }, 0);
    }

    function resumoCampanha(grupoId: number) {
      const lotesDoGrupo = lotes.filter((l) => l.grupo === grupoId);
      const pedidosAvulso = pedidos.filter((p) => p.grupo === grupoId && p.avulso);

      let vendido = 0;
      let arrecadado = 0;
      let pago = 0;
      for (const lote of lotesDoGrupo) {
        const va = vendidoArrecadadoLote(lote);
        vendido += va.vendido;
        arrecadado += va.arrecadado;
        pago += pagoMalhariaLote(lote);
      }
      for (const p of pedidosAvulso) {
        vendido += totalPedido(p);
        arrecadado += Number(p.valor_pago || 0);
      }

      return { vendido, arrecadado, pago, saldo: arrecadado - pago };
    }

    function calcularDashboard() {
      let pecasPedidas = 0;
      let pecasRetiradas = 0;
      let pecasAguardando = 0;

      const linhas = grupos.map((grupo) => {
        const resumo = resumoCampanha(grupo.id);
        let pendentes = 0;
        for (const p of pedidos.filter((p) => p.grupo === grupo.id)) {
          for (const i of itens.filter((i) => i.pedido === p.id)) {
            pecasPedidas += i.quantidade;
            pecasRetiradas += Math.min(i.quantidade, i.quantidade_retirada);
            const pendente = Math.max(0, i.quantidade - i.quantidade_retirada);
            pendentes += pendente;
            if (p.separado) pecasAguardando += pendente;
          }
        }
        return { nome: grupo.nome, ...resumo, pendentes };
      });

      const totais = linhas.reduce(
        (acc, l) => ({ vendido: acc.vendido + l.vendido, arrecadado: acc.arrecadado + l.arrecadado, pago: acc.pago + l.pago }),
        { vendido: 0, arrecadado: 0, pago: 0 },
      );

      return { ...totais, saldo: totais.arrecadado - totais.pago, pecasPedidas, pecasRetiradas, pecasAguardando, linhas };
    }

    async function carregarDashboard() {
      const dashboardWrap = document.querySelector<HTMLElement>("[data-dashboard-wrap]");
      if (!dashboardWrap || grupos.length === 0) return;

      const headers = { Authorization: `Bearer ${token}` };
      const [resPedidos, resItens, resLotes, resLoteItens] = await Promise.all([
        fetch(`${directusUrl}/items/camiseta_pedidos?fields=id,grupo,lote,valor_pago,avulso,separado&limit=-1`, { headers }),
        fetch(`${directusUrl}/items/camiseta_itens_pedido?fields=id,pedido,tamanho,modelo,quantidade,quantidade_retirada&limit=-1`, { headers }),
        fetch(`${directusUrl}/items/camiseta_lotes?fields=id,grupo,status,total_vendido,total_arrecadado,total_pago_malharia&limit=-1`, { headers }),
        fetch(`${directusUrl}/items/camiseta_lote_itens?fields=id,lote,tamanho,modelo,estoque_extra,custo_unitario&limit=-1`, { headers }),
      ]);
      pedidos = resPedidos.ok ? (await resPedidos.json()).data ?? [] : [];
      itens = resItens.ok ? (await resItens.json()).data ?? [] : [];
      lotes = resLotes.ok ? (await resLotes.json()).data ?? [] : [];
      loteItens = resLoteItens.ok ? (await resLoteItens.json()).data ?? [] : [];

      renderizarDashboard();
      dashboardWrap.hidden = false;
    }

    function renderizarDashboard() {
      const d = calcularDashboard();
      const dstat = (nome: string) => document.querySelector<HTMLElement>(`[data-dstat="${nome}"]`);
      const set = (nome: string, texto: string) => { const el = dstat(nome); if (el) el.textContent = texto; };
      set("vendido", brl(d.vendido));
      set("arrecadado", brl(d.arrecadado));
      set("pago", brl(d.pago));
      set("saldo", brl(d.saldo));
      set("pedidas", String(d.pecasPedidas));
      set("aguardando", String(d.pecasAguardando));
      set("retiradas", String(d.pecasRetiradas));

      const corpo = document.querySelector<HTMLElement>("[data-dashboard-corpo]");
      if (corpo) {
        corpo.innerHTML = d.linhas.length
          ? d.linhas
              .map(
                (l) => `
                  <tr>
                    <td>${escapeHtml(l.nome)}</td>
                    <td>${brl(l.vendido)}</td>
                    <td>${brl(l.arrecadado)}</td>
                    <td>${brl(l.saldo)}</td>
                    <td>${l.pendentes}</td>
                  </tr>
                `,
              )
              .join("")
          : `<tr><td colspan="5" class="text-sm text-muted-foreground">Nenhuma campanha ainda.</td></tr>`;
      }
    }

    document.querySelector("[data-exportar-relatorio-pdf]")?.addEventListener("click", () => {
      const d = calcularDashboard();
      const doc = new jsPDF({ unit: "pt", format: "a4" });
      const titulo = "Relatório consolidado — Camisetas e uniformes";
      configurarAcessibilidadePdf(doc, titulo);
      const margem = 56;
      let y = margem;

      doc.setFont("helvetica", "bold");
      doc.setFontSize(16);
      doc.text(titulo, margem, y);
      y += 20;
      doc.setFont("helvetica", "normal");
      doc.setFontSize(10);
      doc.setTextColor(90);
      doc.text(`Gerado em ${new Date().toLocaleDateString("pt-BR")}`, margem, y);
      y += 26;
      doc.setTextColor(20);

      doc.setFont("helvetica", "bold");
      doc.setFontSize(12);
      doc.text("Resumo geral", margem, y);
      y += 18;
      doc.setFont("helvetica", "normal");
      doc.setFontSize(10);
      [
        `Vendido: ${brl(d.vendido)}`,
        `Arrecadado: ${brl(d.arrecadado)}`,
        `Pago à malharia: ${brl(d.pago)}`,
        `Saldo: ${brl(d.saldo)}`,
        `Peças pedidas: ${d.pecasPedidas} · separadas aguardando retirada: ${d.pecasAguardando} · já retiradas: ${d.pecasRetiradas}`,
      ].forEach((linha) => {
        doc.text(linha, margem, y);
        y += 15;
      });

      y += 16;
      const colunas = [
        { titulo: "Campanha", x: margem, largura: 190 },
        { titulo: "Vendido", x: margem + 190, largura: 90 },
        { titulo: "Arrecadado", x: margem + 280, largura: 90 },
        { titulo: "Saldo", x: margem + 370, largura: 70 },
        { titulo: "Pendentes", x: margem + 440, largura: 60 },
      ];
      const larguraTabela = colunas.reduce((s, c) => s + c.largura, 0);
      const alturaPagina = doc.internal.pageSize.getHeight();

      function desenharCabecalho() {
        doc.setFillColor(240, 236, 224);
        doc.rect(margem, y, larguraTabela, 20, "F");
        doc.setFont("helvetica", "bold");
        doc.setFontSize(10);
        colunas.forEach((c) => doc.text(c.titulo, c.x + 6, y + 14));
        y += 20;
      }

      desenharCabecalho();
      doc.setFont("helvetica", "normal");

      d.linhas.forEach((linha) => {
        if (y + 20 > alturaPagina - margem) {
          doc.addPage();
          y = margem;
          desenharCabecalho();
          doc.setFont("helvetica", "normal");
        }
        doc.rect(margem, y, larguraTabela, 20);
        doc.text(linha.nome, colunas[0].x + 6, y + 14);
        doc.text(brl(linha.vendido), colunas[1].x + 6, y + 14);
        doc.text(brl(linha.arrecadado), colunas[2].x + 6, y + 14);
        doc.text(brl(linha.saldo), colunas[3].x + 6, y + 14);
        doc.text(String(linha.pendentes), colunas[4].x + 6, y + 14);
        y += 20;
      });

      doc.save(`camisetas-relatorio-${new Date().toISOString().slice(0, 10)}.pdf`);
    });

    const novoStatus = document.querySelector<HTMLElement>("[data-painel-novo-status]");

    novoBtn?.addEventListener("click", async () => {
      const t = await exigirAutenticacao(directusUrl, AUTH);
      if (!t) return;
      novoBtn.disabled = true;
      if (novoStatus) novoStatus.textContent = "Criando…";
      try {
        // `slug` é obrigatório e único no Directus — um placeholder com
        // timestamp garante que a criação nunca falhe por causa dele; a tela
        // de edição já tem "Gerar do nome" pra trocar por um slug de verdade.
        const res = await fetch(`${directusUrl}/items/camiseta_grupos`, {
          method: "POST",
          headers: { Authorization: `Bearer ${t}`, "Content-Type": "application/json" },
          body: JSON.stringify({ nome: "Nova camiseta", slug: `nova-camiseta-${Date.now()}`, ativo: true }),
        });
        if (!res.ok) throw new Error("falha ao criar");
        const json = await res.json();
        window.location.href = `/painel-camisetas/grupo/?id=${json.data.id}`;
      } catch {
        novoBtn.disabled = false;
        if (novoStatus) novoStatus.textContent = "Não foi possível criar agora. Tente de novo em instantes.";
      }
    });

    sairBtn?.addEventListener("click", () => sair(directusUrl, AUTH));

    async function iniciar() {
      const t = await exigirAutenticacao(directusUrl, AUTH);
      if (!t) return;
      token = t;

      const res = await fetch(`${directusUrl}/users/me?fields=email`, { headers: { Authorization: `Bearer ${token}` } });
      const json = await res.json();

      if (carregando) carregando.hidden = true;
      if (conteudo) conteudo.hidden = false;
      if (usuarioWrap) usuarioWrap.hidden = false;
      if (usuarioEl) usuarioEl.textContent = json.data.email;

      await carregarLotes();
      await carregarDashboard();
    }

    iniciar();
  </script>

  <style is:global>
    .painel-evento-card {
      display: block;
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.25rem 1.4rem;
      transition: border-color var(--duration-fast) var(--ease-out);
    }
    .painel-evento-card:hover {
      border-color: var(--accent);
    }
    .painel-evento-link {
      text-decoration: none;
      color: inherit;
    }
    .painel-evento-titulo {
      display: block;
      font-weight: 600;
      font-size: 1.0625rem;
    }
    .painel-evento-data {
      display: block;
      margin-top: 0.35rem;
      color: var(--muted-foreground);
      font-size: 0.8125rem;
    }
    .stat-card { border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1rem 1.25rem; }
    .stat-numero { font-size: 1.5rem; font-weight: 700; }
    .stat-label { margin-top: 0.25rem; font-size: 0.8125rem; color: var(--muted-foreground); }
    .tabela-camiseta { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
    .tabela-camiseta th, .tabela-camiseta td { padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--border); text-align: left; }
  </style>
</BaseLayout>
