---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { DIRECTUS_URL } from "@/lib/directus";
import { GRUPOS_HOME } from "@/lib/painelConteudo";
import { cartoesHome } from "@/lib/painelModeracao";
import { getAllMensagens, visiblePosts } from "@/lib/posts";
import "@/styles/painel-conteudo.css";

const allPosts = visiblePosts(await getAllMensagens());
// Cartões de conteúdo (editar) e de moderação (aprovar o que o público enviou) lado a lado, agrupados pela seção de cada um.
const cartoes = cartoesHome();
const secoes = GRUPOS_HOME.map((g) => ({ ...g, cartoes: cartoes.filter((c) => c.grupo === g.id) })).filter((g) => g.cartoes.length > 0);
---

<BaseLayout title="Painel de conteúdo" description="Área restrita da equipe." noindex>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer pc-escopo">
    <div class="canvas" data-pc-inicio data-directus-url={DIRECTUS_URL}>
      <header class="pagehead">
        <p class="eyebrow">Área restrita</p>
        <div class="pc-topo-linha">
          <h1 class="pagehead-title">Painel de conteúdo</h1>
          <p class="pc-usuario" data-painel-usuario-wrap hidden>
            <span data-painel-usuario></span> ·{" "}
            <button type="button" class="pc-link-botao" data-painel-sair>Sair</button>
          </p>
        </div>
        <p class="pagehead-description" data-painel-carregando>Verificando sua sessão…</p>
      </header>

      <div hidden data-painel-conteudo>
        <p class="text-sm text-muted-foreground">Escolha o que você quer escrever ou editar.</p>

        <div data-pc-cartoes>
          {
            secoes.map((g) => (
              <section class="pc-secao-home mt-8" data-pc-secao-home={g.id} aria-labelledby={`pc-home-${g.id}`} hidden>
                <h2 class="pc-secao-home-titulo" id={`pc-home-${g.id}`}>
                  {g.titulo}
                </h2>
                <p class="pc-secao-home-texto">{g.descricao}</p>
                <div class="pc-cartoes mt-4">
                  {g.cartoes.map((c) => (
                    <a href={c.href} class="pc-cartao" data-pc-cartao={c.id} data-pc-origem={c.origem} data-astro-reload hidden>
                      <span class="pc-cartao-icone" aria-hidden="true">
                        {c.icone}
                      </span>
                      <span>
                        <span class="pc-cartao-titulo">{c.titulo}</span>
                        <span class="pc-cartao-texto">{c.descricao}</span>
                        <span class="pc-cartao-contagem" data-pc-contagem />
                      </span>
                    </a>
                  ))}
                </div>
              </section>
            ))
          }
        </div>

        <div class="pc-vazio mt-5" data-pc-sem-acesso hidden>
          <p><strong>Seu perfil não tem acesso a nenhum conteúdo aqui.</strong></p>
          <p class="mt-2 text-sm">Se isso parece errado, peça à Secretaria para conferir a sua função no Directus.</p>
        </div>

        <div class="pc-faixa pc-faixa-erro mt-5" data-pc-erro hidden>
          <p data-pc-erro-texto>Não foi possível conferir o seu acesso agora.</p>
          <div class="pc-faixa-botoes">
            <button type="button" class="btn btn-outline" data-pc-tentar>Tentar de novo</button>
          </div>
        </div>
      </div>
    </div>
  </main>
  <SiteFooter />

  <script>
    import { exigirAutenticacao, sair } from "@/lib/painelAuth";
    import { AUTH_CONTEUDO, TIPOS_CONTEUDO, criarApi, iniciarQuandoPronto } from "@/lib/painelConteudo";
    import { TIPOS_MODERACAO, consultaContagem, textoContagemCartao, type TipoModeracao } from "@/lib/painelModeracao";

    iniciarQuandoPronto("[data-pc-inicio]", (raiz) => {
      const directusUrl = raiz.dataset.directusUrl ?? "";
      const api = criarApi(directusUrl, { redirecionar: true });
      const q = <T extends HTMLElement>(seletor: string) => raiz.querySelector<T>(seletor);

      const carregando = q("[data-painel-carregando]");
      const conteudo = q("[data-painel-conteudo]");
      const semAcesso = q("[data-pc-sem-acesso]");
      const erroEl = q("[data-pc-erro]");
      const erroTexto = q("[data-pc-erro-texto]");

      q("[data-painel-sair]")?.addEventListener("click", () => sair(directusUrl, AUTH_CONTEUDO));
      q("[data-pc-tentar]")?.addEventListener("click", () => void verificar());

      /** Pergunta ao Directus, tipo a tipo, se o perfil consegue LER a coleção: 200 mostra o cartão, 403 esconde. */
      async function verificar() {
        if (erroEl) erroEl.hidden = true;
        if (semAcesso) semAcesso.hidden = true;
        let algumVisivel = false;
        let falhou = false;
        /** Moderação: uma contagem por aba que aparece no cartão ("3 aguardando · 1 confidencial"); 403 em qualquer uma esconde o cartão. */
        async function verificarModeracao(tipo: TipoModeracao) {
          const cartao = q<HTMLAnchorElement>(`[data-pc-cartao="${tipo.id}"]`);
          if (!cartao) return;
          const abas = tipo.abas.filter((a) => a.cartao);
          try {
            const respostas = await Promise.all(abas.map((a) => api(consultaContagem(tipo, a.id))));
            if (respostas.some((r) => r.status === 403)) {
              cartao.hidden = true;
              return;
            }
            cartao.hidden = false;
            algumVisivel = true;
            const alvo = cartao.querySelector<HTMLElement>("[data-pc-contagem]");
            const partes: string[] = [];
            for (let i = 0; i < abas.length; i++) {
              const r = respostas[i];
              if (!r.ok) {
                falhou = true;
                continue;
              }
              const json = (await r.json()) as { meta?: { filter_count?: number } };
              const n = json.meta?.filter_count;
              if (typeof n !== "number") continue;
              const frase = textoContagemCartao(tipo, abas[i].id, n);
              if (frase) partes.push(frase);
              if (abas[i].id === "aguardando") {
                cartao.dataset.pcAguardando = String(n);
                alvo?.classList.toggle("pc-cartao-atencao", n > 0);
              }
            }
            if (alvo) alvo.textContent = partes.join(" · ");
          } catch {
            cartao.hidden = false;
            algumVisivel = true;
            falhou = true;
          }
        }

        await Promise.all([
          ...Object.values(TIPOS_CONTEUDO).map(async (tipo) => {
            const cartao = q<HTMLAnchorElement>(`[data-pc-cartao="${tipo.id}"]`);
            if (!cartao) return;
            try {
              const res = await api(`/items/${tipo.colecao}?limit=1&fields=id&meta=filter_count`);
              if (res.status === 403) {
                cartao.hidden = true;
                return;
              }
              cartao.hidden = false;
              algumVisivel = true;
              if (res.ok) {
                const json = (await res.json()) as { meta?: { filter_count?: number } };
                const n = json.meta?.filter_count;
                const alvo = cartao.querySelector<HTMLElement>("[data-pc-contagem]");
                if (alvo && !tipo.unico && typeof n === "number") alvo.textContent = n === 1 ? "1 item" : `${n} itens`;
              } else {
                falhou = true;
              }
            } catch {
              cartao.hidden = false;
              algumVisivel = true;
              falhou = true;
            }
          }),
          ...Object.values(TIPOS_MODERACAO).map(verificarModeracao),
        ]);
        // Uma seção (título + descrição) só aparece se pelo menos um cartão dela apareceu.
        raiz.querySelectorAll<HTMLElement>("[data-pc-secao-home]").forEach((secao) => {
          secao.hidden = !secao.querySelector("[data-pc-cartao]:not([hidden])");
        });
        if (!algumVisivel && semAcesso) semAcesso.hidden = false;
        if (falhou && erroEl) {
          erroEl.hidden = false;
          if (erroTexto) erroTexto.textContent = "Não foi possível conferir tudo agora (o servidor pode estar instável). Os cartões abaixo podem estar incompletos.";
        }
      }

      async function iniciar() {
        const token = await exigirAutenticacao(directusUrl, AUTH_CONTEUDO);
        if (!token) return;
        if (carregando) carregando.hidden = true;
        if (conteudo) conteudo.hidden = false;
        // Quem está logado (opcional: se o perfil não puder ler o próprio usuário, só não mostra).
        void (async () => {
          try {
            const res = await api("/users/me?fields=email");
            if (!res.ok) return;
            const json = (await res.json()) as { data?: { email?: string } };
            const email = json.data?.email;
            const wrap = q("[data-painel-usuario-wrap]");
            const alvo = q("[data-painel-usuario]");
            if (email && wrap && alvo) {
              alvo.textContent = email;
              wrap.hidden = false;
            }
          } catch {
            /* opcional */
          }
        })();
        await verificar();
      }

      void iniciar();
    });
  </script>
</BaseLayout>
