---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { DIRECTUS_URL, fetchItems } from "@/lib/directus";
import { getAllMensagens, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getAllMensagens());
const congregacoes = (await fetchItems<{ id: number; name: string }>("congregacoes", "fields=id,name&sort=name")).sort((a, b) =>
  a.name.localeCompare(b.name, "pt-BR"),
);

// Pra vincular esse evento a uma edição anterior — não precisa ser todo ano,
// pode pular anos, então é uma lista livre, não uma sugestão automática.
const eventosParaVincular = await fetchItems<{ id: number; title: string; event_date: string | null }>(
  "eventos",
  "fields=id,title,event_date&sort=-event_date",
);

const tipoResponsavelOpcoes = [
  { value: "", label: "Sem categoria" },
  { value: "diretoria", label: "Diretoria" },
  { value: "conselho", label: "Conselho" },
  { value: "congregacao", label: "Congregação" },
  { value: "departamento", label: "Departamento/Ministério" },
  { value: "area", label: "Área/Regional" },
];

const tipoPerguntaOpcoes = [
  { value: "texto_curto", label: "Texto curto" },
  { value: "texto_longo", label: "Texto longo" },
  { value: "numero", label: "Número" },
  { value: "data", label: "Data" },
  { value: "selecao_unica", label: "Seleção única" },
  { value: "selecao_multipla", label: "Seleção múltipla" },
];
---

<BaseLayout title="Editar evento — Gestão de eventos" description="Área restrita da equipe." noindex>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas evento-canvas" data-directus-url={DIRECTUS_URL}>
      <header class="pagehead">
        <p class="eyebrow"><a href="/painel-eventos/" class="text-accent">← Gestão de eventos</a></p>
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h1 class="pagehead-title" data-painel-titulo>Evento</h1>
          <div class="flex flex-wrap gap-3">
            <a href="/painel-eventos/evento/inscritos/" class="btn btn-outline" data-link-inscritos hidden>
              Ver inscritos
            </a>
            <a href="/checkin/" class="btn btn-solid" data-link-checkin hidden>
              Fazer check-in
            </a>
          </div>
        </div>
        <p class="pagehead-description" data-painel-carregando>Verificando sua sessão…</p>
      </header>

      <div hidden data-painel-erro class="gallery-empty mt-8">
        <p class="text-sm text-muted-foreground">Evento não encontrado.</p>
      </div>

      <div hidden class="tab-bar mt-8" data-tabs role="tablist">
        <button type="button" class="tab-btn is-active" data-tab="dados">Dados do evento</button>
        <button type="button" class="tab-btn" data-tab="inscricao">Perguntas de inscrição</button>
        <button type="button" class="tab-btn" data-tab="pesquisa">Pesquisa pós-evento</button>
        <button type="button" class="tab-btn" data-tab="agenda">Agenda (sessões)</button>
        <button type="button" class="tab-btn" data-tab="historico">Histórico</button>
        <button type="button" class="tab-btn" data-tab="cupons">Cupons de desconto</button>
        <button type="button" class="tab-btn" data-tab="avancado">Encerrar / Excluir</button>
      </div>

      <div data-tab-panel="dados">
      <form hidden class="mt-8 grid gap-5 max-w-2xl" data-evento-form>
        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="f-title">Título</label>
          <input id="f-title" class="field" required />
        </div>

        <div class="grid gap-2 sm:grid-cols-[1fr_auto] sm:items-end">
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="f-slug">Endereço (slug)</label>
            <input id="f-slug" class="field" placeholder="nome-do-evento" />
          </div>
          <button type="button" class="btn btn-outline" data-gerar-slug>Gerar do título</button>
        </div>

        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="f-description">Resumo curto</label>
          <input id="f-description" class="field" placeholder="Aparece na listagem e no compartilhamento" />
        </div>

        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="f-body">Descrição completa (markdown)</label>
          <textarea id="f-body" rows="6" class="field"></textarea>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="f-event-date">Data</label>
            <input id="f-event-date" type="date" class="field" />
          </div>
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="f-end-date">Data final (se for vários dias)</label>
            <input id="f-end-date" type="date" class="field" />
          </div>
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="f-time">Horário</label>
            <input id="f-time" class="field" placeholder="19h30" />
          </div>
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="f-end-time">Horário final</label>
            <input id="f-end-time" class="field" placeholder="22h" />
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="f-congregacao">Congregação (se aplicável)</label>
            <select id="f-congregacao" class="field">
              <option value="">— Nenhuma (usar local abaixo) —</option>
              {congregacoes.map((c) => <option value={c.id}>{c.name}</option>)}
            </select>
          </div>
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="f-location">Local (se não for numa congregação)</label>
            <input id="f-location" class="field" />
          </div>
        </div>

        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="f-location-busca">Buscar local (Fase 24.4 — mais rápido que colar link)</label>
          <input id="f-location-busca" class="field" placeholder="Digite o nome do lugar…" autocomplete="off" data-places-autocomplete />
          <p class="text-xs text-muted-foreground">
            Comece a digitar e escolha um resultado da lista — preenche sozinho o local e o link
            abaixo, com a coordenada exata do lugar escolhido. Se preferir, ainda dá pra colar o
            link manualmente.
          </p>
        </div>

        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="f-location-maps-url">Link do Google Maps do local (opcional)</label>
          <input id="f-location-maps-url" class="field" placeholder="https://maps.app.goo.gl/..." />
          <p class="text-xs text-muted-foreground">
            No Google Maps, ache o pino certo do local → "Compartilhar" → "Copiar link" → cole
            aqui. Só digitar o endereço às vezes cai na rua errada — colando o link, o mapa da
            página do evento usa a coordenada exata que você mesmo conferiu.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="f-responsavel">Responsável (nome/ministério)</label>
            <input id="f-responsavel" class="field" />
          </div>
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="f-tipo-responsavel">Categoria do responsável</label>
            <select id="f-tipo-responsavel" class="field">
              {tipoResponsavelOpcoes.map((o) => <option value={o.value}>{o.label}</option>)}
            </select>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="f-vagas">Limite de vagas (opcional)</label>
            <input id="f-vagas" type="number" min="0" class="field" placeholder="Deixe em branco = ilimitado" />
          </div>
          <div class="grid gap-2">
            <label class="text-sm font-semibold" for="f-inscricoes-ate">Inscrições até</label>
            <input id="f-inscricoes-ate" type="date" class="field" />
          </div>
        </div>
        <p class="text-xs text-muted-foreground">
          Com limite preenchido, o formulário público trava de verdade — quem se inscrever depois
          das vagas esgotarem entra na lista de espera automaticamente. Se você aumentar o limite
          (ou apagá-lo, deixando ilimitado) e salvar, quem estiver na lista de espera é confirmado
          sozinho, do mais antigo pro mais novo, até preencher as vagas novas.
        </p>

        <label class="flex items-start gap-2 text-sm">
          <input id="f-requer-aprovacao" type="checkbox" class="mt-1" />
          <span>
            <strong>Requer aprovação manual</strong> — pra cursos/escolas com pré-requisito: a
            inscrição não confirma vaga sozinha, fica pendente até alguém da equipe aprovar (aba
            Inscritos). Combina com o limite de vagas acima — a aprovação só confirma vaga se
            ainda houver, senão a pessoa aprovada entra na lista de espera.
          </span>
        </label>

        <fieldset class="grid gap-2">
          <legend class="text-sm font-semibold">Faixas de valor (opcional)</legend>
          <p class="text-xs text-muted-foreground">
            Aparece na página pública do evento. Se o formulário de inscrição tiver mais de uma
            faixa cadastrada, a pessoa escolhe uma delas ao se inscrever, e o valor já fica
            preenchido pra cada pessoa daquela inscrição — não processa pagamento nenhum, só
            registra o valor combinado. Ex.: "Individual" R$50, "Casal" R$80 (R$40 cada), "Grupo
            (5 ou mais, por pessoa)" R$30 — use isso pra dar desconto por grupo/quantidade.
          </p>
          <div class="grid gap-2" data-faixas-lista></div>
          <button type="button" class="btn btn-outline mt-1" data-faixa-adicionar>+ Adicionar faixa</button>
        </fieldset>

        <div class="grid gap-3">
          <label class="flex items-center gap-2 text-sm">
            <input id="f-inscricao-grupo" type="checkbox" /> Permitir inscrição em grupo (família, casal, grupos de amigos etc.)
          </label>
          <p class="text-xs text-muted-foreground">
            Com isso ativado, quem se inscrever pode adicionar o nome de outras pessoas na mesma
            inscrição (cada uma vira uma inscrição própria, com seu próprio código de check-in e
            certificado) — combine com faixas de valor acima pra dar desconto por grupo.
          </p>
        </div>

        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="f-evento-anterior">Edição anterior (opcional)</label>
          <select id="f-evento-anterior" class="field">
            <option value="">— Nenhuma (primeira edição, ou evento avulso) —</option>
            {eventosParaVincular.map((e) => (
              <option value={e.id}>
                {e.title}
                {e.event_date ? ` — ${e.event_date}` : ""}
              </option>
            ))}
          </select>
          <p class="text-xs text-muted-foreground">
            Vincule só se esse evento for uma nova edição de algo que já rolou antes (seminário,
            congresso, etc.) — não precisa ser todo ano, pode pular anos. Habilita a comparação
            histórica na aba "Histórico".
          </p>
        </div>

        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="f-checkin-minutos">Libera o check-in quantos minutos antes do horário?</label>
          <input id="f-checkin-minutos" type="number" min="0" class="field" placeholder="60" />
          <p class="text-xs text-muted-foreground">
            A página pública de check-in fica fechada até essa contagem começar — evita gente
            confirmando presença horas (ou dias) antes do evento de verdade.
          </p>
        </div>

        <div class="grid gap-3">
          <label class="flex items-center gap-2 text-sm">
            <input id="f-checkin-manual" type="checkbox" /> Liberar check-in agora (ignora o horário)
          </label>
          <p class="text-xs text-muted-foreground">
            Pra abrir mais cedo do que o automático, se precisar (imprevisto, mudança de horário
            de última hora etc.).
          </p>
        </div>

        <fieldset class="grid gap-2">
          <legend class="text-sm font-semibold">Locais de check-in (opcional)</legend>
          <p class="text-xs text-muted-foreground">
            Se o evento tem mais de uma portaria/entrada, cadastre os nomes aqui — quem for fazer
            check-in escolhe uma vez qual local aquele aparelho representa (fica guardado só
            naquele aparelho), e toda confirmação feita dali em diante já leva essa marcação
            sozinha. Deixe em branco se só existe um jeito de entrar.
          </p>
          <div class="grid gap-2" data-locais-checkin-lista></div>
          <button type="button" class="btn btn-outline mt-1" data-local-checkin-adicionar>+ Adicionar local</button>
        </fieldset>

        <div class="grid gap-3">
          <label class="flex items-center gap-2 text-sm">
            <input id="f-inscricoes-encerradas" type="checkbox" /> Encerrar inscrições manualmente agora
          </label>
        </div>

        <div class="flex items-center gap-4">
          <button type="submit" class="btn btn-solid" data-evento-salvar>Salvar evento</button>
          <p class="text-sm" data-evento-status role="status" aria-live="polite"></p>
        </div>
      </form>
      </div>

      <div data-tab-panel="inscricao" hidden>
      <section hidden class="mt-8" data-perguntas-secao-inscricao aria-labelledby="perguntas-heading">
        <h2 id="perguntas-heading" class="section-title">Perguntas do formulário de inscrição</h2>
        <p class="mt-2 text-sm text-muted-foreground">
          Cada evento define suas próprias perguntas — não existe campo fixo além de nome e
          telefone. Ex.: "Qual sua congregação?", "Vai levar acompanhante?", "Contribuição (R$)".
        </p>

        <div class="mt-5 grid gap-3" data-perguntas-lista-inscricao></div>

        <div class="mt-6 pergunta-card" data-pergunta-nova-inscricao>
          <p class="text-sm font-semibold">+ Nova pergunta de inscrição</p>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            <input type="text" class="field" placeholder="Texto da pergunta" data-novo-label-inscricao />
            <select class="field" data-novo-tipo-inscricao>
              {tipoPerguntaOpcoes.map((o) => <option value={o.value}>{o.label}</option>)}
            </select>
          </div>
          <textarea
            class="field mt-3"
            rows="2"
            placeholder="Opções (uma por linha) — só pra seleção única/múltipla"
            data-novo-opcoes-inscricao
            hidden
          ></textarea>
          <div class="mt-3 flex items-center justify-between gap-3">
            <label class="flex items-center gap-2 text-sm">
              <input type="checkbox" data-novo-obrigatoria-inscricao /> Obrigatória
            </label>
            <button type="button" class="btn btn-outline" data-adicionar-pergunta-inscricao>Adicionar pergunta</button>
          </div>
        </div>
      </section>
      </div>

      <div data-tab-panel="pesquisa" hidden>
      <section hidden class="mt-8" data-perguntas-secao-pesquisa aria-labelledby="pesquisa-heading">
        <h2 id="pesquisa-heading" class="section-title">Pesquisa de satisfação (pós-evento)</h2>
        <p class="mt-2 text-sm text-muted-foreground">
          Perguntas feitas só depois do evento, na pesquisa pública (<code>/pesquisa/&lt;slug do evento&gt;/</code>),
          liberada automaticamente a partir do dia seguinte ao evento — nunca aparecem no formulário de inscrição.
        </p>

        <div class="mt-5 grid gap-3" data-perguntas-lista-pesquisa></div>

        <div class="mt-6 pergunta-card" data-pergunta-nova-pesquisa>
          <p class="text-sm font-semibold">+ Nova pergunta da pesquisa</p>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            <input type="text" class="field" placeholder="Texto da pergunta" data-novo-label-pesquisa />
            <select class="field" data-novo-tipo-pesquisa>
              {tipoPerguntaOpcoes.map((o) => <option value={o.value}>{o.label}</option>)}
            </select>
          </div>
          <textarea
            class="field mt-3"
            rows="2"
            placeholder="Opções (uma por linha) — só pra seleção única/múltipla"
            data-novo-opcoes-pesquisa
            hidden
          ></textarea>
          <div class="mt-3 flex items-center justify-between gap-3">
            <label class="flex items-center gap-2 text-sm">
              <input type="checkbox" data-novo-obrigatoria-pesquisa /> Obrigatória
            </label>
            <button type="button" class="btn btn-outline" data-adicionar-pergunta-pesquisa>Adicionar pergunta</button>
          </div>
        </div>
      </section>
      </div>

      <div data-tab-panel="agenda" hidden>
      <section hidden class="mt-8" data-agenda-secao aria-labelledby="agenda-heading">
        <h2 id="agenda-heading" class="section-title">Agenda interna (sessões/palestras)</h2>
        <p class="mt-2 text-sm text-muted-foreground">
          Pra eventos com várias palestras/horários (congressos, seminários) — aparece na página
          pública do evento como uma programação, abaixo da descrição. Se o evento for de vários
          dias, preencha o campo "Dia" pra agrupar cada sessão no dia certo; se for de um dia só,
          pode deixar em branco.
        </p>

        <div class="mt-5 grid gap-3" data-sessoes-lista></div>

        <div class="mt-6 pergunta-card" data-sessao-nova>
          <p class="text-sm font-semibold">+ Nova sessão</p>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            <input type="text" class="field" placeholder="Título da sessão/palestra" data-novo-sessao-titulo />
            <input type="text" class="field" placeholder="Palestrante (opcional)" data-novo-sessao-palestrante />
          </div>
          <div class="mt-3 grid gap-3 sm:grid-cols-[auto_1fr_1fr]">
            <input type="date" class="field" data-novo-sessao-dia title="Dia (só p/ evento de vários dias)" />
            <input type="text" class="field" placeholder="Horário início (19h30)" data-novo-sessao-inicio />
            <input type="text" class="field" placeholder="Horário fim (opcional)" data-novo-sessao-fim />
          </div>
          <input type="text" class="field mt-3" placeholder="Local (opcional, só se for diferente do local do evento)" data-novo-sessao-local />
          <textarea class="field mt-3" rows="2" placeholder="Descrição (opcional)" data-novo-sessao-descricao></textarea>
          <div class="mt-3 flex items-center justify-end gap-3">
            <button type="button" class="btn btn-outline" data-adicionar-sessao>Adicionar sessão</button>
          </div>
        </div>
      </section>
      </div>

      <div data-tab-panel="historico" hidden>
      <section hidden class="mt-8" data-historico-secao aria-labelledby="historico-heading">
        <h2 id="historico-heading" class="section-title">Histórico entre edições</h2>
        <p class="mt-2 text-sm text-muted-foreground">
          Compara esse evento com as edições anteriores vinculadas na aba "Dados do evento" — só
          aparece número de uma edição depois que ela passa por "Encerrar evento" (é lá que os
          números finais ficam gravados). Funciona mesmo que as edições não sejam todo ano.
        </p>
        <div class="mt-5" data-historico-conteudo></div>
      </section>
      </div>

      <div data-tab-panel="cupons" hidden>
      <section hidden class="mt-8" data-cupons-secao aria-labelledby="cupons-heading">
        <h2 id="cupons-heading" class="section-title">Cupons de desconto</h2>
        <p class="mt-2 text-sm text-muted-foreground">
          Não existe processador de pagamento nenhum — isso aqui só registra que a pessoa ganhou
          um desconto, pra a equipe saber quanto cobrar de verdade (manualmente) na hora de
          confirmar o pagamento. Quem se inscrever digita o código no formulário público; não
          aparece em nenhum lugar em destaque — só quem souber o código consegue usar.
        </p>

        <div class="mt-5 grid gap-3" data-cupons-lista></div>

        <div class="mt-6 pergunta-card" data-cupom-novo>
          <p class="text-sm font-semibold">+ Novo cupom</p>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            <input type="text" class="field" placeholder="Código (ex.: DIRETORIA10)" data-novo-cupom-codigo />
            <select class="field" data-novo-cupom-tipo>
              <option value="percentual">Percentual (%)</option>
              <option value="fixo">Valor fixo (R$)</option>
            </select>
          </div>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            <input type="number" step="0.01" min="0" class="field" placeholder="Valor do desconto" data-novo-cupom-valor />
            <input type="number" min="1" class="field" placeholder="Limite de usos (opcional)" data-novo-cupom-limite />
          </div>
          <div class="mt-3 grid gap-3 sm:grid-cols-[1fr_auto]">
            <input type="date" class="field" data-novo-cupom-validade title="Válido até (opcional)" />
            <label class="flex items-center gap-2 text-sm whitespace-nowrap">
              <input type="checkbox" data-novo-cupom-ativo checked /> Ativo
            </label>
          </div>
          <div class="mt-3 flex items-center justify-end gap-3">
            <button type="button" class="btn btn-outline" data-adicionar-cupom>Adicionar cupom</button>
          </div>
        </div>
      </section>
      </div>

      <div data-tab-panel="avancado" hidden>
      <div hidden class="mt-8 zona-encerrar" data-zona-encerrar>
        <p class="text-sm font-semibold">Encerrar evento</p>
        <p class="mt-1 text-sm text-muted-foreground">
          Baixa um relatório de encerramento em PDF (resumo + fechamento de caixa) e cria um
          rascunho de notícia (não publicado, pra revisar antes). Nome, código, telefone (guardado
          como hash — nunca em texto puro, ver README/Fase 6), presença, respostas e valores
          <strong>continuam guardados pra sempre</strong> — é o que garante que a pessoa consiga
          baixar o certificado dela a qualquer momento, mesmo anos depois. Não é uma exclusão.
        </p>
        <button type="button" class="btn btn-outline mt-3" data-encerrar-evento>Encerrar evento</button>
        <p class="mt-2 text-sm" data-encerrar-status role="status" aria-live="polite"></p>
      </div>

      <div hidden class="mt-6 zona-perigo" data-zona-perigo>
        <p class="text-sm font-semibold text-red-700">Excluir evento</p>
        <p class="mt-1 text-sm text-muted-foreground">
          Remove o evento, suas perguntas e todas as inscrições (com respostas). Não pode ser
          desfeito.
        </p>
