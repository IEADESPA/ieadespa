---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { VERIFICAR_INSCRICAO_URL, fetchItems } from "@/lib/directus";
import { getAllMensagens, visiblePosts } from "@/lib/posts";

interface Evento {
  id: number;
  slug: string;
  title: string;
  aceita_inscricao: boolean;
}

export async function getStaticPaths() {
  const events = await fetchItems<Evento>("eventos", "filter[aceita_inscricao][_eq]=true");
  // slug e opcional no Directus - sem essa checagem, evento sem slug ainda
  // definido quebraria o build (mesmo bug corrigido em toda pagina por slug).
  return events.filter((event) => event.slug).map((event) => ({ params: { slug: event.slug }, props: { event } }));
}

interface Props {
  event: Evento;
}

const { event } = Astro.props;
const allPosts = visiblePosts(await getAllMensagens());
---

<BaseLayout title={`Meu QR Code — ${event.title}`} description="Gere seu QR Code de check-in — mostre pra portaria na entrada." noindex>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas qrcode-canvas">
      <header class="pagehead">
        <p class="eyebrow">Meu QR Code</p>
        <h1 class="pagehead-title">{event.title}</h1>
        <p class="pagehead-description">
          Gere seu QR Code de check-in aqui mesmo na fila — não precisa ter salvo nada antes. É só
          mostrar a tela pra portaria escanear.
        </p>
      </header>

      <form class="mt-8 grid gap-4 max-w-sm" data-qrcode-form data-evento-id={event.id} data-verificar-url={VERIFICAR_INSCRICAO_URL}>
        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="qrcode-codigo">Código de confirmação</label>
          <input
            id="qrcode-codigo"
            type="text"
            autocomplete="off"
            autocapitalize="characters"
            maxlength="6"
            class="field qrcode-codigo-input"
            placeholder="A3F9K2"
          />
        </div>
        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="qrcode-telefone">Telefone usado na inscrição</label>
          <input id="qrcode-telefone" type="tel" autocomplete="tel" class="field" placeholder="(00) 00000-0000" />
        </div>
        <button type="submit" class="btn btn-solid">Gerar QR Code</button>
      </form>

      <details class="mt-6">
        <summary class="cursor-pointer text-sm font-semibold text-accent">Esqueceu o código? Buscar pelo nome</summary>
        <div class="mt-4 grid gap-3 max-w-sm">
          <input type="text" class="field" placeholder="Digite seu nome…" data-qrcode-busca-nome autocomplete="off" />
          <div class="grid gap-2" data-qrcode-resultados-nome></div>
          <div class="grid gap-2" data-qrcode-confirmar-telefone hidden>
            <label class="text-sm font-semibold" for="qrcode-telefone-confirmar">
              Confirme o telefone usado na inscrição de <span data-qrcode-nome-escolhido></span>
            </label>
            <input id="qrcode-telefone-confirmar" type="tel" autocomplete="tel" class="field" placeholder="(00) 00000-0000" />
            <button type="button" class="btn btn-outline" data-qrcode-confirmar-btn>Confirmar</button>
          </div>
        </div>
      </details>

      <p class="mt-6 text-lg font-semibold" data-qrcode-resultado role="status" aria-live="polite" />
      <div class="mt-4 qrcode-imagem" data-qrcode-imagem></div>
    </div>
  </main>
  <SiteFooter />

  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js"></script>
  <script is:inline define:vars={{ verificarUrl: VERIFICAR_INSCRICAO_URL, eventoId: event.id }}>
    (() => {
      const form = document.querySelector("[data-qrcode-form]");
      const resultado = document.querySelector("[data-qrcode-resultado]");
      const imagemEl = document.querySelector("[data-qrcode-imagem]");
      const buscaInput = document.querySelector("[data-qrcode-busca-nome]");
      const resultadosNome = document.querySelector("[data-qrcode-resultados-nome]");
      const confirmarTelefoneWrap = document.querySelector("[data-qrcode-confirmar-telefone]");
      const nomeEscolhidoEl = document.querySelector("[data-qrcode-nome-escolhido]");
      const telefoneConfirmarInput = document.getElementById("qrcode-telefone-confirmar");
      const confirmarBtn = document.querySelector("[data-qrcode-confirmar-btn]");

      const escapeHtml = (value) =>
        String(value).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);

      function gerarQrCode(nome, codigo) {
        const qr = qrcode(0, "M");
        qr.addData(`${eventoId}:${codigo}`);
        qr.make();
        imagemEl.innerHTML = qr.createImgTag(
          8,
          8,
          `QR Code de check-in de ${nome}. Se não conseguir escanear, o operador também aceita o código ${codigo} digitado manualmente.`,
        );
        resultado.textContent = `✅ QR Code de ${nome} pronto — mostre pra portaria.`;
      }

      async function verificar(payload) {
        const res = await fetch(verificarUrl, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ evento: eventoId, ...payload }),
        });
        return res.json();
      }

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const codigo = document.getElementById("qrcode-codigo").value.trim().toUpperCase();
        const telefone = document.getElementById("qrcode-telefone").value.trim();
        imagemEl.innerHTML = "";

        if (!telefone) {
          resultado.textContent = "Digite o telefone usado na inscrição.";
          return;
        }

        resultado.textContent = "Verificando…";

        try {
          const pessoa = await verificar({ modo: "codigo", codigo, telefone });
          if (!pessoa?.encontrado) {
            resultado.textContent = "Código ou telefone não conferem. Confira e tente de novo, ou busque pelo nome abaixo.";
            return;
          }
          gerarQrCode(pessoa.nome, pessoa.codigo);
        } catch {
          resultado.textContent = "Não foi possível buscar agora. Tente novamente em instantes.";
        }
      });

      // Busca por nome: só lista candidatos (sem código nenhum) — o código
      // só é devolvido depois de confirmar o telefone de quem foi escolhido,
      // pra impedir que a busca por nome sozinha revele o código de outra
      // pessoa.
      buscaInput?.addEventListener("input", async () => {
        const termo = buscaInput.value.trim();
        confirmarTelefoneWrap.hidden = true;
        if (termo.length < 2) {
          resultadosNome.innerHTML = "";
          return;
        }

        try {
          const resposta = await verificar({ modo: "nome", nome: termo });
          const candidatos = resposta?.candidatos ?? [];
          resultadosNome.innerHTML = candidatos
            .map((p) => `<button type="button" class="btn btn-outline" data-pessoa-id="${p.id}" data-pessoa-nome="${escapeHtml(p.nome)}">${escapeHtml(p.nome)}</button>`)
            .join("");
        } catch {
          resultadosNome.innerHTML = "";
        }
      });

      let pessoaEscolhidaId = null;

      resultadosNome?.addEventListener("click", (event) => {
        const button = event.target.closest("[data-pessoa-id]");
        if (!button) return;
        pessoaEscolhidaId = button.dataset.pessoaId;
        nomeEscolhidoEl.textContent = button.dataset.pessoaNome;
        confirmarTelefoneWrap.hidden = false;
        telefoneConfirmarInput.focus();
      });

      confirmarBtn?.addEventListener("click", async () => {
        const telefone = telefoneConfirmarInput.value.trim();
        if (!telefone || !pessoaEscolhidaId) return;
        imagemEl.innerHTML = "";
        resultado.textContent = "Gerando…";
        try {
          const pessoa = await verificar({ modo: "id", id: pessoaEscolhidaId, telefone });
          if (!pessoa?.encontrado) {
            resultado.textContent = "Telefone não confere com essa inscrição.";
            return;
          }
          gerarQrCode(pessoa.nome, pessoa.codigo);
          resultadosNome.innerHTML = "";
          confirmarTelefoneWrap.hidden = true;
          buscaInput.value = "";
        } catch {
          resultado.textContent = "Não foi possível gerar agora. Tente novamente em instantes.";
        }
      });
    })();
  </script>

  <style>
    .qrcode-canvas {
      max-width: 40rem;
    }

    .qrcode-codigo-input {
      text-transform: uppercase;
      letter-spacing: 0.2em;
      font-size: 1.5rem;
      text-align: center;
      font-family: var(--font-mono);
    }

    .qrcode-imagem :global(img) {
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1rem;
      background: #fff;
    }
  </style>
</BaseLayout>
