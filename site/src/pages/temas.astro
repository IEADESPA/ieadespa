---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { categoryDescriptions } from "@/config/categories";
import { siteConfig } from "@/config/site";
import { categoryHref, getCategoryList, getAllMensagens, visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getAllMensagens());
const categoryList = getCategoryList(allPosts);
---

<BaseLayout
  title="Temas"
  description={`Todos os temas das mensagens de ${siteConfig.name}, com contagem de mensagens.`}
>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Índice</p>
        <h1 class="pagehead-title">Temas</h1>
        <p class="pagehead-description">
          {allPosts.length} mensagens, organizadas em {categoryList.length}
          {categoryList.length === 1 ? "tema" : "temas"}.
        </p>
      </header>

      <ul class="grid gap-7">
        {
          categoryList.map((category) => (
            <li class="border-b border-border pb-7 last:border-b-0">
              <a href={categoryHref(category.name)} class="link-title">
                <span class="flex items-baseline justify-between gap-4">
                  <span class="link-title__text text-xl font-semibold tracking-tight">{category.name}</span>
                  <span class="pill shrink-0">
                    {category.count} {category.count === 1 ? "mensagem" : "mensagens"}
                  </span>
                </span>
                <span class="mt-2 block max-w-2xl text-pretty text-sm leading-relaxed text-muted-foreground">
                  {categoryDescriptions[category.name]}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
